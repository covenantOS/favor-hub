{
  "name": "favoros-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/layout-css.mjs && vite dev --port 5190",
    "build": "node scripts/layout-css.mjs && vite build",
    "test": "node scripts/layout-css.mjs && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "echo use scripts/ship-web.mjs",
    "tour": "vite build -c vite.tour.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "description": "FavorOS web app: TanStack Start on the favoros-web Worker (see docs/web-app.md)."
}
