---
// The ? menu in the header (2026-10-15 cleanup): help for this page, the help home, the tour and what is new, Feedback and the keyboard
// shortcuts. Help for this page opens the help article for the page you are on, with its videos, in a side panel.
// The page is read from body[data-nav] when pressed, so a page swapped in place opens its own article.
// Pages with no article, or a help index that cannot load, get the help home.
import { icon } from '../data/icons';
---
<div class="h-qm" id="h-qm">
  <button type="button" class="h-top__cam h-qm__btn" id="h-qm-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="h-qmenu" aria-label="Help and feedback" title="Help and feedback"><Fragment set:html={icon('help')} /></button>
  <div class="h-qmenu" id="h-qmenu" role="menu" aria-label="Help and feedback" hidden>
    <button type="button" role="menuitem" class="lp-btn" id="lp-btn" aria-haspopup="dialog"><Fragment set:html={icon('help')} />Help for this page</button>
    <a role="menuitem" href="/help/"><Fragment set:html={icon('book')} />Help home</a>
    <button type="button" role="menuitem" data-tour-start><Fragment set:html={icon('play')} />Tour and what is new<span class="h-nav__count" data-count="tours" hidden></span></button>
    <button type="button" role="menuitem" data-feedback="hub"><Fragment set:html={icon('chat')} />Feedback</button>
    <button type="button" role="menuitem" data-keys-open><Fragment set:html={icon('tools')} />Keyboard shortcuts</button>
  </div>
</div>
<dialog class="lp" id="lp-dlg" aria-labelledby="lp-title">
  <div class="lp__in">
    <div class="lp__bar"><span>Help</span><button type="button" class="lp__x" data-lp-close aria-label="Close help">&times;</button></div>
    <div id="lp-body"></div>
  </div>
</dialog>

<style is:global>
  .lp { position: fixed; inset: 0 0 0 auto; margin: 0; width: min(440px, 100vw); max-width: 100vw; height: 100dvh; max-height: none; padding: 0; border: 0; border-left: 1px solid var(--h-line); background: var(--h-surface); color: var(--h-ink); box-shadow: var(--h-shadow-2); }
  .lp::backdrop { background: rgba(29, 33, 27, 0.25); }
  .lp__in { box-sizing: border-box; height: 100%; overflow-y: auto; padding: 14px 20px 28px; }
  .lp__bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font: 600 13px/1 var(--h-font); letter-spacing: 0.06em; text-transform: uppercase; color: var(--h-ink-3); }
  .lp__x { width: 40px; height: 40px; border: 0; border-radius: 10px; background: none; color: var(--h-ink-2); font-size: 24px; line-height: 1; cursor: pointer; }
  .lp__x:hover { background: var(--h-leaf-soft); color: var(--h-ink); }
  .lp__x:focus-visible, .lp__go:focus-visible { outline: 2px solid var(--h-brand-ink); outline-offset: 2px; }
  .lp h2 { margin: 0 0 8px; font: 600 20px/1.25 var(--h-font); color: var(--h-ink); }
  .lp p { margin: 0; font: 400 15px/1.55 var(--h-font); color: var(--h-ink-2); }
  .lp figure { margin: 18px 0 0; }
  .lp video { display: block; width: 100%; border-radius: var(--h-radius); background: #000; }
  .lp figcaption { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 8px; font: 600 14px/1.35 var(--h-font); color: var(--h-ink); }
  .lp figcaption span { font-weight: 500; color: var(--h-ink-3); }
  .lp__go { display: inline-flex; margin-top: 18px; font: 600 14px var(--h-font); color: var(--h-brand-ink); }
  .lp__go:hover { text-decoration: underline; }
  .lp__load { color: var(--h-ink-3); }
  .lp__more { display: grid; gap: 8px; margin-top: 16px; }
  .lp[open] { animation: lp-in 0.22s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .lp[open]::backdrop { animation: lp-fade 0.22s ease; }
  .lp__skel { display: grid; gap: 10px; padding-top: 6px; }
  .lp__skel i { display: block; height: 14px; border-radius: 7px; background: #efe9db; }
  .lp__skel i:first-child { height: 24px; width: 60%; }
  .lp__skel i:last-child { width: 80%; }
  @keyframes lp-in { from { transform: translateX(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes lp-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .lp[open], .lp[open]::backdrop { animation: none; } }
</style>

<script>
  type Vid = { slug: string; title: string; length: string; src: string; poster: string; track: string };
  type Index = { articles: Record<string, { title: string; summary: string; href: string; videos: Vid[] }>; pages: Record<string, string> };

  // The ? menu: opens under its button, closes on a pick, a press outside or Escape. Keyboard shortcuts open the ? sheet (hub-keys.js).
  const qmBtn = document.getElementById('h-qm-btn');
  const qm = document.getElementById('h-qmenu');
  if (qmBtn && qm) {
    const setQm = (on: boolean) => { qm.hidden = !on; qmBtn.setAttribute('aria-expanded', String(on)); if (on) qm.querySelector<HTMLElement>('[role=menuitem]')?.focus({ preventScroll: true }); };
    qmBtn.addEventListener('click', (e) => { e.stopPropagation(); setQm(qm.hidden); });
    qm.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest('[data-keys-open]')) (window as any).hubKeys?.open?.();
      if (t.closest('[role=menuitem]')) setQm(false);
    });
    document.addEventListener('click', (e) => { if (!qm.hidden && !(e.target as Element).closest('#h-qm')) setQm(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !qm.hidden) { setQm(false); qmBtn.focus(); } });
  }
  const btn = document.getElementById('lp-btn') as HTMLButtonElement | null;
  const dlg = document.getElementById('lp-dlg') as HTMLDialogElement | null;
  const body = document.getElementById('lp-body');
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);

  let index: Promise<Index | null> | null = null;
  const load = () => {
    if (!index) index = fetch('/help/learn.json', { credentials: 'same-origin' }).then((r) => (r.ok ? (r.json() as Promise<Index>) : null)).catch(() => null);
    return index;
  };

  const home = () =>
    `<h2 id="lp-title">Help</h2><p>No article for this page yet.</p><div class="lp__more"><a class="lp__go" href="/help/">Open the help home</a></div>`;

  const article = (a: Index['articles'][string]) => {
    return `<h2 id="lp-title">${esc(a.title)}</h2><p>${esc(a.summary)}</p><a class="lp__go" href="${esc(a.href)}">Read the full article</a>`;
  };

  let loaded: Index | null | undefined;
  const fill = (idx: Index | null) => {
    const nav = document.body.dataset.nav || '';
    const slug = idx && nav ? idx.pages[nav] : '';
    const a = idx && slug ? idx.articles[slug] : null;
    body!.innerHTML = a ? article(a) : home();
  };
  // The panel lives under the page body, not inside the header, so no header rule (a button size, a flex rule) can ever reach it.
  if (dlg && dlg.parentElement !== document.body) document.body.appendChild(dlg);
  if (btn && dlg && body) {
    // The index loads while the page is idle, so the panel opens with its answer already in it.
    const idle = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 1200));
    idle(() => load().then((i) => { loaded = i; }));
    btn.addEventListener('click', async () => {
      if (loaded !== undefined) fill(loaded);
      else body.innerHTML = '<div class="lp__skel" role="status" aria-label="Loading"><i></i><i></i><i></i></div>';
      if (!dlg.open) dlg.showModal();
      if (loaded === undefined) { loaded = await load(); fill(loaded); }
      dlg.querySelector<HTMLElement>('.lp__x')?.focus({ preventScroll: true });
    });
    dlg.querySelector('[data-lp-close]')?.addEventListener('click', () => dlg.close());
    // A press on the backdrop, outside the panel's box, closes it.
    let downOn: EventTarget | null = null;
    dlg.addEventListener('pointerdown', (e) => { downOn = e.target; }, true);
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg && (downOn === dlg || downOn === null)) dlg.close();
      downOn = null;
    });
  }
</script>
