---
// "Open in Google Sheets": the button public/js/sheets.js runs. The page registers what it sends with
// FavorSheets.register(name, () => spec).
interface Props { name: string; label?: string; class?: string; hidden?: boolean }
const { name, label = 'Open in Google Sheets', class: cls = 'h-btn h-btn--ghost h-btn--sm', hidden = false } = Astro.props;
---
<button type="button" class={cls} data-sheets={name} hidden={hidden}><svg class="h-i" viewBox="0 0 24 24" aria-hidden="true" style="width:16px;height:16px"><path d="M6 2.5h8.5L19 7v13.5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-17a1 1 0 0 1 1-1z" fill="#0f9d58" stroke="none"/><path d="M14.5 2.5V7H19" fill="#87ceac" stroke="none"/><rect x="8" y="10.5" width="8" height="7" rx=".5" fill="#fff" stroke="none"/><path d="M8 13h8M8 15.3h8M11 10.5v7" stroke="#0f9d58" stroke-width=".9" fill="none"/></svg>{label}</button>
