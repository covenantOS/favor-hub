---
// The head every Admin page shares: the title and the row of admin pages. A page may pass one fact staff need (fact);
// a line that describes the page (lede) is not drawn, the title and the tabs already say it. On the overview the title
// repeats the top bar, so it stays for screen readers only.
import { ADMIN_PAGES } from '../data/admin-pages';
import '../styles/crit-reportadmin.css';
interface Props { on: string; title: string; lede?: string; fact?: string; }
const { on, title, fact = '' } = Astro.props;
// The settings pages share one row of tabs. The pages above them (Overview, People and roles, Audit log) sit in the menu's own tab row.
const TABS = ADMIN_PAGES.filter((p) => p.live && p.tab);
const showTabs = TABS.some((p) => p.id === on);
---
{on === 'overview'
  ? <h1 class="sr-only">{title}</h1>
  : <header class="ad-head">
      <div>
        <h1>{title}</h1>
        {fact && <p class="h-lede">{fact}</p>}
      </div>
    </header>}
{showTabs && <nav class="ad-tabs" aria-label="Settings pages">
  <div class="ad-tabs__row">
    {TABS.map((p) => <a class={`ad-tab${p.id === on ? ' is-on' : ''}`} href={p.href} aria-current={p.id === on ? 'page' : undefined}>{p.label}</a>)}
  </div>
</nav>}
<script is:inline>
  // The tab for this page can sit off screen in the scrolling row; bring it into view without moving the page.
  (function () {
    var on = document.querySelector('.ad-tab.is-on');
    var row = on && on.parentElement;
    if (row && row.scrollWidth > row.clientWidth) row.scrollLeft = Math.max(0, on.offsetLeft - (row.clientWidth - on.offsetWidth) / 2);
  })();
</script>
