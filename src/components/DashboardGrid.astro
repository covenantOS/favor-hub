---
import Tile from './Tile.astro';

const tiles = [
  {
    num: '01',
    title: 'Website & app requests',
    desc: 'Fixes, new pages, job posts. Will reviews the board.',
    href: '/requests/new',
    cta: 'Make a request',
    featured: true,
    icon: 'board',
  },
  {
    num: '02',
    title: 'Blackbaud',
    desc: 'Donor records.',
    href: 'https://app.blackbaud.com/signin/?redirectUrl=https://app.blackbaud.com/',
    cta: 'Sign in',
    featured: true,
    icon: 'database',
  },
  {
    num: '03',
    title: 'GoHighLevel',
    desc: 'Email and marketing.',
    href: 'https://my.favor.international',
    cta: 'Open',
    icon: 'zap',
  },
  {
    num: '04',
    title: 'RDD Reports',
    desc: 'Staff only. Password on the next screen.',
    href: '/rdd',
    cta: 'Unlock',
    locked: true,
    icon: 'lock',
  },
  {
    num: '05',
    title: 'Media Folder',
    desc: 'Photos and videos from the field.',
    href: 'https://drive.google.com/drive/folders/1vJQn3vvoxKWKjW4ZmYDDfPZ0Li_w8-ZU',
    cta: 'Browse',
    icon: 'image',
  },
  {
    num: '06',
    title: 'Marketing Materials',
    desc: 'Spreadsheet of current pieces.',
    href: 'https://docs.google.com/spreadsheets/d/1voiT9f4oixPz0cRAJrQTyik-PqCwP3hGGhC-br1PjOU/edit?usp=sharing',
    cta: 'View',
    icon: 'sheet',
  },
  {
    num: '07',
    title: 'Marketing Request',
    desc: 'Asana form for a new project.',
    href: 'https://form.asana.com/?k=ZLVP4wa-hVh36WUjOH4FyQ&d=1200803238481574',
    cta: 'Submit',
    icon: 'send',
  },
  {
    num: '08',
    title: 'Time Off',
    desc: 'Paycom PTO.',
    href: 'https://phx.us-west.paycomonline.net/v4/ee/web.php/accruals/time-off',
    cta: 'Request',
    icon: 'calendar',
  },
  {
    num: '09',
    title: 'Time Sheet',
    desc: 'Paycom punch in and out.',
    href: 'https://www.paycomonline.net/v4/ee/web.php/app/login',
    cta: 'Punch',
    icon: 'clock',
  },
  {
    num: '10',
    title: 'Paycom Expenses',
    desc: 'Cards and expense reports in Paycom.',
    href: 'https://www.paycomonline.net/v4/ee/web.php/app/login',
    cta: 'Manage',
    icon: 'card',
  },
  {
    num: '11',
    title: 'Expense Request',
    desc: 'Expenses and purchases, signed online. Not Paycom.',
    href: '/expenses/new',
    cta: 'Submit',
    icon: 'receipt',
  },
];
---
<section class="section" id="dashboard">
  <div class="container">
    <header class="section-head">
      <h2>Tools</h2>
    </header>
    <div class="tiles">
      {tiles.map((t) => <Tile {...t} />)}
    </div>
  </div>
</section>
