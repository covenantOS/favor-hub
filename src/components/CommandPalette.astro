---
import { getCollection } from 'astro:content';
import videos from '../data/videos.json';
import { buildPaletteItems } from '../data/palette';
import { MOVED_UNTIL as WAS_UNTIL } from '../data/areas';

// Help articles and videos only show once someone types, so the opening list stays short.
const docs = (await getCollection('help')).sort((a, b) => a.data.order - b.data.order);
const items = buildPaletteItems(
  docs.map((d) => ({ title: d.data.title, summary: d.data.summary, id: d.id, topic: d.data.topic, body: d.body || '' })),
  videos
);
---
<div class="cmdk" id="cmdk" hidden role="dialog" aria-modal="true" aria-label="FavorOS search">
  <div class="cmdk__overlay" data-cmdk-close></div>
  <div class="cmdk__panel">
    <div class="cmdk__head">
      <svg class="cmdk__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        id="cmdk-input"
        placeholder="Jump to anything…"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Search"
      />
      <kbd class="cmdk__esc" data-cmdk-close>esc</kbd>
    </div>
    <ul class="cmdk__list" id="cmdk-list" role="listbox" aria-label="Search results"></ul>
    <div class="cmdk__empty" id="cmdk-empty" hidden>
      No matches. Try another search.
    </div>
    <div class="cmdk__foot">
      <span><kbd>↑</kbd><kbd>↓</kbd>&nbsp;navigate</span>
      <span><kbd>↵</kbd>&nbsp;open</span>
      <span><kbd>esc</kbd>&nbsp;close</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ items, WAS_UNTIL }}>
  const cmdk = document.getElementById('cmdk');
  const input = document.getElementById('cmdk-input');
  const list = document.getElementById('cmdk-list');
  const empty = document.getElementById('cmdk-empty');
  let selected = 0;
  let current = items;

  const norm = (s) => (s || '').toLowerCase();

  function score(item, q) {
    if (!q) return 1;
    const t = norm(item.title);
    const d = norm(item.desc);
    const tags = norm(item.tags);
    if (t.startsWith(q)) return 4;
    if (t.includes(q)) return 3;
    if (tags.includes(q)) return 2;
    if (d.includes(q)) return 1;
    return 0;
  }

  // Pages this person may not open stay out of the list. The saved sidebar answer holds their access and KPI teams.
  function allowed(i) {
    if (!i.need && !i.team) return true;
    let d = window.FAVOR_HUB;
    if (!d) { try { d = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); } catch (e) { d = null; } }
    const access = (d && d.access) || {};
    if (i.need && !access[i.need]) return false;
    if (i.team && !((d && d.kpiTeams) || []).includes(i.team)) return false;
    return true;
  }
  // Your pages are the ones in your rail and your tab rows (your job's pages and everyone's); the pages of other people's jobs follow
  // under Other pages. A page that moved in the October split shows where it was ("Was Work > Statements") for a month.
  function myJobs() {
    let d = window.FAVOR_HUB;
    if (!d) { try { d = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); } catch (e) { d = null; } }
    return d && Array.isArray(d.jobs) ? d.jobs : null;
  }
  const jobOk = (jobs, mine) => (window.hubJobMatch ? window.hubJobMatch(jobs, mine) : true);
  const wasOn = new Date().toISOString().slice(0, 10) < WAS_UNTIL;
  function shaped(i, mine) {
    if (!i.page || i.area === 'tools') return i;
    const own = jobOk(i.jobs ? String(i.jobs).split(' ') : null, mine);
    const path = i.desc.split(' · ')[0];
    return Object.assign({}, i, { group: own ? 'Your pages' : 'Other pages', desc: wasOn && i.was ? path + ' · Was ' + i.was : i.desc });
  }
  function filter(q) {
    const lq = norm(q.trim());
    const mine = myJobs();
    const pool = items.filter(allowed).map((i) => shaped(i, mine));
    if (!lq) return pool.filter((i) => !i.searchOnly && !(i.menu === false));
    return pool
      .map((i) => ({ i, s: score(i, lq) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s)
      .map((x) => x.i);
  }

  function render(arr) {
    current = arr;
    if (!arr.length) {
      list.innerHTML = '';
      empty.hidden = false;
      return;
    }
    empty.hidden = true;
    let html = '';
    let lastGroup = null;
    arr.forEach((item, idx) => {
      if (item.group !== lastGroup) {
        html += `<li class="cmdk__group" aria-hidden="true">${item.group}</li>`;
        lastGroup = item.group;
      }
      html += `<li role="option" data-idx="${idx}" data-href="${item.href}" data-ext="${!!item.external}">
        <span class="cmdk__row-title">${item.title}</span>
        <span class="cmdk__row-desc">${item.desc}</span>
        <span class="cmdk__row-arrow" aria-hidden="true">↵</span>
      </li>`;
    });
    list.innerHTML = html;
    selected = 0;
    highlight();
  }

  function highlight() {
    const rows = list.querySelectorAll('li[role="option"]');
    rows.forEach((li) => li.classList.remove('is-sel'));
    const target = rows[selected];
    if (target) {
      target.classList.add('is-sel');
      target.scrollIntoView({ block: 'nearest' });
    }
  }

  function open() {
    cmdk.hidden = false;
    input.value = '';
    for (const k of Object.keys(remote)) remote[k] = [];
    render(merged(filter('')));
    requestAnimationFrame(() => input.focus());
    document.body.style.overflow = 'hidden';
  }
  function close() {
    cmdk.hidden = true;
    document.body.style.overflow = '';
  }

  function navigateTo(item) {
    if (!item) return;
    if (item.href === '#nav-toggle') { close(); window.dispatchEvent(new Event('hub-nav-toggle')); return; }
    if (item.external) { window.open(item.href, '_blank', 'noopener'); close(); return; }
    // Take the search's history entry off first; a page change started while that step is pending would be cancelled by it.
    // A request opens in its panel on the page the person is on.
    const rq = /^\/requests\/\?r=/.test(item.href) && window.FavorRequest ? new URL(item.href, location.href).searchParams.get('r') : '';
    const go = () => { if (rq) window.FavorRequest.open(rq); else window.location.href = item.href; close(); };
    const ov = window.hubOv;
    if (ov && ov.depth()) ov.unwind(go); else go();
  }

  // Hotkey: Cmd-K, Ctrl-K, or "/"
  document.addEventListener('keydown', (e) => {
    const k = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
    const slash = e.key === '/' && !cmdk.hidden === false && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName);
    if (k) { e.preventDefault(); cmdk.hidden ? open() : close(); return; }
    if (slash) { e.preventDefault(); open(); return; }
    if (cmdk.hidden) return;

    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowDown') {
      e.preventDefault();
      selected = Math.min(selected + 1, current.length - 1);
      highlight();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selected = Math.max(selected - 1, 0);
      highlight();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      navigateTo(current[selected]);
    }
  });

  // Search has three tiers. Tier 1 is local (pages, tools, help) and redraws on every keystroke. Tier 2 asks the server
  // after a short pause, in two steps: partners, reports and Brain chats first, then meetings and clips. Tier 3 is for slow
  // sources such as Drive and runs after tier 2 settles. Every server call applies the signed-in person's access, so a
  // row this person cannot open never comes back. A denied or failed source shows no rows and the rest keep working.
  const escHtml = (t) => String(t == null ? '' : t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const KIND_ORDER = ['Your pages', 'Actions', 'Partners', 'Requests', 'Projects', 'Menu', 'Tools', 'Reports', 'Other pages', 'Meetings', 'Chat', 'Clips', 'Learn', 'Favor Brain', 'Help', 'External', 'Drive'];
  const kindRank = (g) => KIND_ORDER.indexOf(g);
  const remote = { partners: [], requests: [], projects: [], reports: [], chats: [], meetings: [], messages: [], clips: [], learn: [], drive: [] };
  let seq = 0;
  let remoteTimer = 0;
  let partnerDenied = false;
  let reportsAll = null;

  async function getJson(url) {
    try {
      const res = await fetch(url, { credentials: 'same-origin', headers: { 'X-Hub-Request': '1' } });
      if (!res.ok) return { denied: res.status === 401 || res.status === 403, data: null };
      return { denied: false, data: await res.json().catch(() => null) };
    } catch (_) {
      return { denied: false, data: null };
    }
  }
  const when = (iso) => { const d = new Date(iso); return isNaN(d) ? '' : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); };

  // The saved menu (favor.hub.nav.v1) knows what this person may open; a search skips the reads the server would refuse.
  function navDenies(key) {
    try { const nv = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); return !!(nv && nv.access && nv.access[key] === false); } catch (e) { return false; }
  }

  // Partners: the Work Center's partner search (name, email, phone, address, lookup id).
  async function partnerHits(text) {
    if (partnerDenied || navDenies('workCenter')) return [];
    const r = await getJson('/api/work/partners?wide=1&q=' + encodeURIComponent(text));
    if (r.denied) partnerDenied = true;
    const rows = r.data && Array.isArray(r.data.rows) ? r.data.rows : [];
    return rows.map((h) => ({ title: escHtml(h.name), desc: escHtml((h.place || 'No city on file') + (h.lookup ? ' · ' + h.lookup : '') + (h.deceased ? ' · deceased' : '')), href: '/work/partner/' + encodeURIComponent(h.cid), external: false, group: 'Partners' }));
  }

  // Projects hook: projects by name, key or team, and tasks by code, title or description (projects/links/today.ts searchFor).
  async function projectHits(text) {
    const r = await getJson('/api/tasks/links/search?q=' + encodeURIComponent(text));
    const rows = r.data && Array.isArray(r.data.hits) ? r.data.hits : [];
    return rows.map((h) => ({ title: escHtml(h.title), desc: escHtml(h.desc), href: h.url, external: false, group: 'Projects' }));
  }

  // Requests on the board, by title, by what was asked, or by a person on it (who asked, the owner, who it waits on).
  async function requestHits(text) {
    const r = await getJson('/api/requests/search?q=' + encodeURIComponent(text));
    const rows = r.data && Array.isArray(r.data.results) ? r.data.results : [];
    return rows.map((h) => ({ title: escHtml(h.title), desc: escHtml(['Request', h.status, h.owner ? 'Owner ' + h.owner : 'Asked by ' + h.asked_by, h.waiting_on ? 'Waiting on ' + h.waiting_on : ''].filter(Boolean).join(' · ')), href: h.url, external: false, group: 'Requests' }));
  }

  // Reports: the registry this person may open, read once per page and matched here. Only ready reports get a row.
  async function reportHits(text) {
    if (!reportsAll) {
      const r = await getJson('/api/reports');
      if (!r.data || !Array.isArray(r.data.reports)) return [];
      reportsAll = r.data.reports.filter((x) => x.ready);
    }
    const lq = norm(text);
    return reportsAll
      .filter((x) => norm(`${x.name} ${x.who || ''} ${x.replaces || ''}`).includes(lq))
      .slice(0, 8)
      .map((x) => ({ title: escHtml(x.name), desc: escHtml(x.who || 'Report'), href: '/reports/?r=' + encodeURIComponent(x.id), external: false, group: 'Reports' }));
  }

  // The person's own Favor Brain chats, matched on title and on what they asked.
  async function chatHits(text) {
    const r = await getJson('/api/brain/history?q=' + encodeURIComponent(text));
    const threads = r.data && Array.isArray(r.data.threads) ? r.data.threads : [];
    return threads.slice(0, 8).map((t) => ({ title: escHtml(t.title || 'Untitled chat'), desc: escHtml(when(t.changed_at) ? 'Chat · ' + when(t.changed_at) : 'Chat'), href: '/brain/?c=' + encodeURIComponent(t.id), external: false, group: 'Favor Brain' }));
  }

  // Meetings: ended meetings whose notes, summary or transcript match, ended meetings and upcoming meetings whose title matches.
  async function meetingHits(text) {
    // Meetings is not open to everyone yet; without it the three reads below are refused on every keystroke.
    if (navDenies('meetings')) return [];
    const lq = norm(text);
    const [notes, recent, upcoming] = await Promise.all([
      getJson('/api/meet/meetings?scope=notes&q=' + encodeURIComponent(text)),
      getJson('/api/meet/meetings?scope=recent'),
      getJson('/api/meet/meetings?scope=upcoming'),
    ]);
    const rows = [];
    const seen = new Set();
    const add = (m, href, desc) => {
      if (!m || !m.id || seen.has(m.id)) return;
      seen.add(m.id);
      rows.push({ title: escHtml(m.title || 'Meeting'), desc: escHtml(desc), href, external: false, group: 'Meetings' });
    };
    const notesOf = (notes.data && Array.isArray(notes.data.meetings)) ? notes.data.meetings : [];
    for (const m of notesOf) add(m, '/meet/notes/?m=' + encodeURIComponent(m.id), 'Meeting notes' + (m.hostName ? ' · ' + m.hostName : ''));
    const titled = (list) => (list.data && Array.isArray(list.data.meetings) ? list.data.meetings : []).filter((m) => norm(m.title).includes(lq));
    for (const m of titled(recent)) add(m, '/meet/notes/?m=' + encodeURIComponent(m.id), 'Meeting notes' + (m.endedAt ? ' · ' + when(m.endedAt) : ''));
    for (const m of titled(upcoming)) add(m, '/meet/room/?m=' + encodeURIComponent(m.id), 'Meeting' + (m.startsAt ? ' · ' + when(m.startsAt) : ''));
    return rows.slice(0, 10);
  }

  // Chat messages the person can read, only for people who may use Chat.
  async function messageHits(text) {
    if (!document.documentElement.classList.contains('has-chat')) return [];
    const r = await getJson('/api/chat/search?q=' + encodeURIComponent(text));
    const rows = r.data && Array.isArray(r.data.results) ? r.data.results : [];
    return rows.slice(0, 6).map((m) => ({
      title: escHtml(String(m.body || '').replace(/<@([^>]+)>/g, (_a, id) => '@' + (id === 'brain' ? 'Favor Brain' : id.split('@')[0])).replace(/\s+/g, ' ').slice(0, 90) || 'Message'),
      desc: escHtml((m.channel_name ? '#' + m.channel_name : 'Direct message') + ' · ' + when(m.created_at)),
      href: '/chat/?c=' + encodeURIComponent(m.channel_id) + '&m=' + m.id + (m.thread_id ? '&t=' + m.thread_id : ''),
      external: false,
      group: 'Chat',
    }));
  }

  // Clips: the person's own library, matched on titles, summaries, what was said and what was on screen.
  async function clipHits(text) {
    const r = await getJson('/api/clips?q=' + encodeURIComponent(text));
    const clips = r.data && Array.isArray(r.data.clips) ? r.data.clips : [];
    return clips.slice(0, 8).map((c) => ({
      title: escHtml(c.title || 'Untitled clip'),
      desc: escHtml(c.match ? c.match.text : (c.summary || 'Clip')),
      href: '/c/' + encodeURIComponent(c.id) + (c.match ? '?t=' + Math.floor(c.match.at) : ''),
      external: false,
      group: 'Clips',
    }));
  }

  // Drive files: up to six the person can open, from the Brain's Drive index (permission-checked on the server).
  // Only Google Drive and Docs links are shown. The route gives up after 8 seconds, so a slow Drive never holds the list.
  async function driveHits(text) {
    let res;
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 8000);
    try {
      res = await fetch('/api/brain/drive/search', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-Hub-Request': '1' }, body: JSON.stringify({ query: text }), signal: ctrl.signal });
    } catch (_) {
      return [];
    } finally {
      clearTimeout(timer);
    }
    if (!res.ok) return [];
    const data = await res.json().catch(() => null);
    const files = data && Array.isArray(data.files) ? data.files : [];
    return files
      .filter((f) => f && /^https:\/\/(drive|docs)\.google\.com\//.test(f.link || ''))
      .slice(0, 6)
      .map((f) => ({
        title: escHtml((f.name || '').trim() || 'Untitled file'),
        desc: escHtml([f.type, f.owner, f.modified ? when(f.modified + 'T12:00:00') : '', f.folder].filter(Boolean).join(' · ')),
        href: f.link,
        external: true,
        group: 'Drive',
      }));
  }

  // Learn: published courses and learning paths by title, summary, audience or lesson name.
  async function learnHits(text) {
    const r = await getJson('/api/learn/search?q=' + encodeURIComponent(text));
    const rows = r.data && Array.isArray(r.data.results) ? r.data.results : [];
    return rows.map((h) => ({ title: escHtml(h.title), desc: escHtml(h.desc), href: h.href, external: false, group: 'Learn' }));
  }

  // Merge the local list with every server source. Groups keep KIND_ORDER, and rows inside a group keep their order.
  function merged(local) {
    const extra = [].concat(remote.partners, remote.requests, remote.projects, remote.reports, remote.chats, remote.meetings, remote.messages, remote.clips, remote.learn, remote.drive);
    return local.concat(extra)
      .map((x, i) => ({ x, i }))
      .sort((a, b) => kindRank(a.x.group) - kindRank(b.x.group) || a.i - b.i)
      .map((r) => r.x);
  }
  // Redraw with the newest local and server rows, and keep the highlighted row where it still is.
  function redraw() {
    const keep = current[selected] ? current[selected].href : '';
    render(merged(filter(input.value)));
    const at = keep ? current.findIndex((x) => x.href === keep) : -1;
    if (at >= 0) selected = at;
    highlight();
  }
  // A late answer applies only when the person has not typed since it was asked for.
  function apply(kind, hits, mine, text) {
    if (mine !== seq || input.value.trim() !== text) return;
    remote[kind] = hits;
    redraw();
  }
  const source = (kind, text, mine, load) => load().then((hits) => apply(kind, hits, mine, text)).catch(() => undefined);

  async function runRemote(text, mine) {
    // Tier 2a: quick answers.
    await Promise.all([
      source('partners', text, mine, () => partnerHits(text)),
      source('requests', text, mine, () => requestHits(text)),
      source('projects', text, mine, () => projectHits(text)),
      source('reports', text, mine, () => reportHits(text)),
      source('chats', text, mine, () => chatHits(text)),
    ]);
    // Tier 2b: meetings and clips, after the quick answers have drawn.
    await Promise.all([
      source('meetings', text, mine, () => meetingHits(text)),
      source('clips', text, mine, () => clipHits(text)),
      source('messages', text, mine, () => messageHits(text)),
      source('learn', text, mine, () => learnHits(text)),
    ]);
    // Tier 3: Drive files, last. Its rows join the list when they arrive; the rows above never wait for it.
    await source('drive', text, mine, () => driveHits(text));
  }

  input.addEventListener('input', () => {
    const text = input.value.trim();
    const mine = ++seq;
    clearTimeout(remoteTimer);
    for (const k of Object.keys(remote)) remote[k] = [];
    render(merged(filter(input.value)));
    if (text.length < 2) return;
    remoteTimer = setTimeout(() => runRemote(text, mine), 180);
  });

  list.addEventListener('click', (e) => {
    const li = e.target.closest('li[role="option"]');
    if (!li) return;
    selected = +li.dataset.idx;
    navigateTo(current[selected]);
  });

  document.querySelectorAll('[data-cmdk-close]').forEach((el) => {
    el.addEventListener('click', (e) => { e.preventDefault(); close(); });
  });

  // Public trigger from header button
  document.querySelectorAll('[data-cmdk-open]').forEach((el) => {
    el.addEventListener('click', (e) => { e.preventDefault(); open(); });
  });
</script>

<style is:global>
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: start center;
    padding: 12vh 16px 16px;
  }
  .cmdk__overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 15, 12, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: cmdkFade 200ms ease;
  }
  .cmdk__panel {
    position: relative;
    width: min(620px, 100%);
    background: var(--cream);
    border: 1px solid var(--rule);
    border-radius: 18px;
    box-shadow: 0 30px 80px -20px rgba(13, 15, 12, 0.4), 0 0 0 1px rgba(13, 15, 12, 0.04);
    overflow: hidden;
    animation: cmdkRise 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes cmdkFade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes cmdkRise {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .cmdk__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px 14px;
    border-bottom: 1px solid var(--rule);
  }
  .cmdk__search-icon { color: var(--ink-soft); flex-shrink: 0; }
  .cmdk__head input {
    flex: 1;
    font-family: var(--body);
    font-size: 16px;
    background: none;
    border: none;
    outline: none;
    color: var(--ink);
    padding: 4px 0;
  }
  .cmdk__head input::placeholder { color: var(--ink-soft); opacity: 0.6; }
  .cmdk__esc {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: var(--paper-warm);
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid var(--rule);
    cursor: pointer;
  }
  .cmdk__list {
    list-style: none;
    margin: 0;
    padding: 8px 8px 6px;
    max-height: 50vh;
    overflow-y: auto;
  }
  .cmdk__list::-webkit-scrollbar { width: 6px; }
  .cmdk__list::-webkit-scrollbar-thumb { background: var(--rule-strong); border-radius: 3px; }

  .cmdk__group {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 12px 12px 6px;
  }
  .cmdk__group:first-child { padding-top: 6px; }

  .cmdk__list li[role="option"] {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4px 12px;
    padding: 10px 12px;
    border-radius: 10px;
    cursor: pointer;
    transition: background 120ms ease;
  }
  .cmdk__list li[role="option"] .cmdk__row-title {
    font-family: var(--display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
