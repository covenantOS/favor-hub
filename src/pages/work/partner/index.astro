  <div class="pv-top">
    <a class="h-btn h-btn--ghost h-btn--sm" href="/work/"><svg class="h-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"/></svg>Work Center</a>
    <div class="pv-searchhost" id="pv-search"></div>
  </div>
  <div id="pv-root" aria-live="polite"><div class="h-skel" style="height:360px;border-radius:18px"></div></div>
  <script is:inline src="/js/partner.js?v=1" defer></script>
</App>
