---
import App from '../../layouts/App.astro';
import '../../styles/work.css';
import '../../styles/work-edit.css';
import '../../styles/wc-mine.css';
import '../../styles/work-start.css';
import '../../styles/work-addpartner.css';
import '../../styles/work-asks.css';
import '../../styles/work-letters.css';
---
<App full title="Work Center" crumb="Work" nav="work" description="Every open action in Blackbaud, the week's contacts to enter, and the thank-yous still owed, in one place.">
  <div class="wc-root" id="wc-root" aria-live="polite">
    <div class="wc-intro">
      <p>Every open action in Blackbaud, the week's contacts to enter, and the thank-yous still owed, in one place. Pick as many as you need and finish them together.</p>
    </div>
    <div id="view">
      <section class="h-card wc-sheet" id="wc-board" aria-busy="true" aria-label="Open actions"><div class="h-skel" style="height:360px;border-radius:18px"></div></section>
    </div>
  </div>
  <div class="wc-bar" id="bar" role="region" aria-label="Selected actions"></div>
  <div class="wc-toast" id="toast" role="status" aria-live="polite"></div>
  <div id="layer"></div>
  <script is:inline src="/js/work-tabs.js?v=1" defer></script>
  <script is:inline src="/js/work-start.js?v=1" defer></script>
  <script is:inline src="/js/work-edit.js?v=3" defer></script>
  <script is:inline src="/js/work-addpartner.js?v=1" defer></script>
  <script is:inline src="/js/work-gifts.js?v=2" defer></script>
  <script is:inline src="/js/work.js?v=5" defer></script>
  <script is:inline src="/js/wc-mine.js?v=1" defer></script>
  <script is:inline src="/js/work-asks.js?v=1" defer></script>
  <script is:inline src="/js/work-letter.js?v=1" defer></script>
  <script is:inline src="/js/work-hqty.js?v=1" defer></script>
</App>
