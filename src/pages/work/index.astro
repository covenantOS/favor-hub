---
import App from '../../layouts/App.astro';
import '../../styles/work.css';
import '../../styles/work-edit.css';
import '../../styles/wc-mine.css';
import '../../styles/work-start.css';
import '../../styles/work-addpartner.css';
import '../../styles/work-asks.css';
import '../../styles/work-letters.css';
import '../../styles/work-cadence.css';
import '../../styles/work-functions.css';
import '../../styles/work-week.css';
import '../../styles/qa-work.css';
import '../../styles/fix-work.css';
import '../../styles/qa2-wcasks.css';
import '../../styles/crit-work.css';
import '../../styles/crit-work2.css';
import '../../styles/q3-desk.css';
import '../../styles/lint-fix.css';
import '../../styles/wc-fix.css';
// Worst-case data fixes (scripts/break-ui).
import '../../styles/break-ui.css';
---
<App full title="Work Center" crumb="Work" nav="work" description="Every open action in Blackbaud, the week's contacts to enter, and the thank-yous still owed, in one place.">
  <div class="wc-root" id="wc-root" aria-live="polite">
    <div class="wc-intro"></div>
    <div id="view">
      <section class="h-card wc-sheet" id="wc-board" aria-busy="true" aria-label="Open actions"><div class="h-skel" style="height:360px;border-radius:18px"></div></section>
    </div>
  </div>
  <div class="wc-bar" id="bar" role="region" aria-label="Selected actions"></div>
  <div class="wc-toast" id="toast" role="status" aria-live="polite"></div>
  <div id="layer"></div>
  <script is:inline>
    // The board, the recent changes and the sign-in check start now, while the page's scripts download, so the first rows draw as soon as work.js runs.
    (function () {
      if (/[?&]as=/.test(location.search)) return;
      var h = { credentials: 'same-origin', headers: { 'X-Hub-Request': '1' } };
      var get = function (u) { return fetch(u, h).then(function (r) { return r.json().then(function (j) { if (!r.ok || j.ok === false) { var e = new Error(j.message || 'Something went wrong. Try again.'); e.data = j; e.status = r.status; throw e; } return j; }); }); };
      window.__wcEarly = { board: get('/api/work/board?limit=3000'), recent: get('/api/work/recent') };
      window.__wcEarly.board.catch(function () {}); window.__wcEarly.recent.catch(function () {});
      if (window.hubGate) window.hubGate().catch(function () {});
    })();
  </script>
  <script is:inline src="/js/wc-snap.js?v=2" defer></script>
  <script is:inline src="/js/work-tabs.js?v=3" defer></script>
  <script is:inline src="/js/work-start.js?v=3" defer></script>
  <script is:inline src="/js/work-edit.js?v=8" defer></script>
  <script is:inline src="/js/work-addpartner.js?v=2" defer></script>
  <script is:inline src="/js/work-gifts.js?v=7" defer></script>
  <script is:inline src="/js/copy-stamp.js?v=1" defer></script>
  <script is:inline src="/js/work.js?v=21" defer></script>
  <script is:inline src="/js/wc-mine.js?v=9" defer></script>
  <script is:inline src="/js/work-asks.js?v=5" defer></script>
  <script is:inline src="/js/work-letter.js?v=2" defer></script>
  <script is:inline src="/js/work-hqty.js?v=5" defer></script>
  <script is:inline src="/js/work-cadence.js?v=5" defer></script>
  <script is:inline src="/js/work-declines.js?v=2" defer></script>
  <script is:inline src="/js/work-grants.js?v=3" defer></script>
  <script is:inline src="/js/work-giftimages.js?v=2" defer></script>
  <script is:inline src="/js/work-week-report.js?v=1" defer></script>
  <script is:inline src="/js/work-week.js?v=5" defer></script>
</App>
