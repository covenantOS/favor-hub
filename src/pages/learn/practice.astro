---
// Practice mode: a pretend partner record for entering a gift and logging a call. /js/practice.js draws it from /api/growth/practice.
// Nothing entered here reaches Blackbaud or a real partner.
import App from '../../layouts/App.astro';
import '../../styles/practice.css';
import '../../styles/lint-fix.css';
---
<App title="Practice" crumb="Learn" nav="practice" description="A pretend partner record for practicing gift entry and logging a call.">
  <div class="pr" id="pr" aria-busy="true">
    <div class="pr-head"><div><h1>Practice</h1></div></div>
    <div class="pr-skel h-skel"></div>
  </div>
  <script is:inline src="/js/practice.js?v=1" defer></script>
</App>
