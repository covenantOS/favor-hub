---
// Learn: Catalog. The page is a frame; /js/learn.js draws it from /api/learn and moves between Learn pages without a reload.
import App from '../../layouts/App.astro';
import '../../styles/learn.css';
import '../../styles/lint-fix.css';
---
<App title="Catalog" crumb="Learn" nav="learn-catalog" description="Every course and learning path.">
  <div class="ln" id="ln" data-view="catalog" aria-busy="true">
    <div class="ln-head"><div><h1>Catalog</h1></div></div>
    <div class="ln-list"><div class="ln-card ln-skel h-skel"></div><div class="ln-card ln-skel h-skel"></div></div>
  </div>
  <script is:inline src="/js/learn.js?v=3" defer></script>
</App>
