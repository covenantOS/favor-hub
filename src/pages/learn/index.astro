---
// Learn: My learning. The page is a frame; /js/learn.js draws it from /api/learn and moves between Learn pages without a reload.
import App from '../../layouts/App.astro';
import '../../styles/learn.css';
import '../../styles/lint-fix.css';
---
<App title="My learning" crumb="Learn" nav="learn" description="Courses and learning paths assigned to you, and where you left off.">
  <div class="ln" id="ln" data-view="home" aria-busy="true">
    <div class="ln-head"><div><h1>My learning</h1></div></div>
    <div class="ln-list"><div class="ln-card ln-skel h-skel"></div><div class="ln-card ln-skel h-skel"></div></div>
  </div>
  <script is:inline src="/js/learn.js?v=1" defer></script>
</App>
