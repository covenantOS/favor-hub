---
// Favor Chat: channels, direct messages, threads, reactions, mentions, files from Drive, clips, meeting cards and @Favor Brain.
// public/js/chat/chat-ui.js draws the screen; chat.js talks to /api/chat and the live WebSocket. Open to hub admins for now
// (hub setting chat.enabled). The Brain's answer blocks reuse the Brain page's renderer and styles.
import App from '../../layouts/App.astro';
import '../../styles/brain.css';
import '../../styles/chat.css';
import '../../styles/crit-chat.css';
import '../../styles/q3-chat.css';
import '../../styles/huddle.css';
import '../../styles/lint-fix.css';
import '../../styles/chat2.css';
import { SPRITE } from '../brain/_icons';
// Worst-case data fixes (scripts/break-ui).
import '../../styles/break-ui.css';
import { readFileSync } from 'node:fs';
import { createContext, runInContext } from 'node:vm';

// The first paint is the real screen: the same skeleton chat-ui.js draws while it loads the channels, so nothing is replaced with a different layout.
const ctx: any = { window: {}, document: {}, Intl, matchMedia: () => ({ matches: false }) };
createContext(ctx);
runInContext(readFileSync(new URL('../../../public/js/chat/chat-ui.js', import.meta.url), 'utf8'), ctx);
const bootHtml: string = ctx.window.FavorChat.bootHtml();
---
<App title="Chat" crumb="Chat" nav="chat" bare description="Channels, direct messages and threads for the Favor team, with clips, meetings, Drive files and Favor Brain in the conversation.">
  <Fragment set:html={SPRITE} />
  <div id="chat-root" class="ch" data-view="list" data-boot set:html={bootHtml}></div>
  <link rel="preload" href="/js/chat/chat-ui.js?v=29" as="script" />
  <link rel="preload" href="/js/chat/chat.js?v=11" as="script" />
  <link rel="preload" href="/js/brain-blocks.js?v=13" as="script" />
  <script is:inline src="/js/brain-blocks.js?v=13"></script>
  <script is:inline src="/js/meet/prejoin.js?v=5" defer></script>
  <script is:inline src="/js/chat/chat-view.js?v=2" defer></script>
  <script is:inline src="/js/chat/task-card.js?v=3" defer></script>
  <script is:inline src="/js/chat/chat-emoji.js?v=1" defer></script>
  <script is:inline src="/js/chat/chat-brain.js?v=1" defer></script>
  <!-- projects hook: project task cards, Make a task from a message, open in place -->
  <link rel="stylesheet" href="/css/projects-links.css?v=1" />
  <link rel="stylesheet" href="/css/chat-smart.css?v=1" />
  <script is:inline src="/js/projects/links.js?v=1" defer></script>
  <script is:inline src="/js/chat/project-card.js?v=1" defer></script>
  <script is:inline src="/js/chat/chat-smart.js?v=4" defer></script>
  <script is:inline src="/js/chat/chat-ui.js?v=29" defer></script>
  <script is:inline src="/js/chat/chat.js?v=11" defer></script>
</App>
