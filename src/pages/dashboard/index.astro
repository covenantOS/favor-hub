---
// The KPI dashboard inside the hub, exactly as kpi.favorintl.org shows it. The hub hands the person
// over with /api/kpi/enter, so there is no second sign-in. Every staff member opens it; the dashboard
// shows each person the Executive page and only their own team's tab (kpi-dashboard backend/access.js).
import App from '../../layouts/App.astro';
---
<App title="KPI dashboard" crumb="Dashboard" nav="kpi" wide description="The KPI dashboard inside the hub.">
  <a slot="actions" class="h-btn h-btn--ghost h-btn--sm h-hide-sm" href="https://kpi.favorintl.org/" target="_blank" rel="noopener">Open in its own tab</a>
  <div class="h-frame-wrap">
    <div class="h-frame-wait" id="kpi-wait" role="status"><span class="h-spin" aria-hidden="true"></span>Opening the KPI dashboard</div>
    <iframe class="h-frame" id="kpi-frame" title="KPI dashboard" src="about:blank"></iframe>
  </div>
  <script is:inline>
    (() => {
      const frame = document.getElementById('kpi-frame');
      const asked = new URLSearchParams(location.search).get('page') || '/';
      frame.addEventListener('load', () => {
        if (frame.src !== 'about:blank') document.getElementById('kpi-wait').hidden = true;
      });
      frame.src = '/api/kpi/enter?next=' + encodeURIComponent(asked);
    })();
  </script>
</App>
