---
import App from '../../layouts/App.astro';
import '../../styles/requests.css';
import '../../styles/expenses.css';
import '../../styles/foundations.css';
import '../../styles/qa-work.css';
import '../../styles/crit-forms.css';
import '../../styles/q3-desk.css';
import '../../styles/lint-fix.css';
// Worst-case data fixes (scripts/break-ui).
import '../../styles/break-ui.css';
import '../../styles/ptable.css';
import '../../styles/pt-lists.css';
---
<App full title="Foundation prospects" crumb="Work" nav="foundations" description="Every foundation the team has contacted, what was said, and what Blackbaud already holds.">
  <div class="fnd-page">
    <div class="container">
      <header class="board-intro">
        <div>
          <h1>Foundation <em>prospects</em></h1>
          
        </div>
        <div class="board-intro__actions" id="fnd-actions" hidden>
          <label class="fnd-who">
            <span>Entered by</span>
            <input id="fnd-who" list="fnd-staff" placeholder="Your name" autocomplete="off" maxlength="60" />
            <datalist id="fnd-staff">
              <option value="Rachel Cox"></option>
              <option value="Caden"></option>
              <option value="Grace Morris"></option>
              <option value="Joe Krol"></option>
              <option value="Crystal Hall"></option>
              <option value="Gregory Phipps"></option>
              <option value="Jordan Abbott"></option>
              <option value="Stephanie Brady"></option>
              <option value="Brian Carr"></option>
              <option value="Rick Brown"></option>
              <option value="Celeste Paul"></option>
              <option value="Will Hamilton"></option>
            </datalist>
          </label>
          <button type="button" class="req-submit" id="fnd-add">Add a foundation</button>
          <button type="button" class="req-ghost" id="fnd-lock" title="Lock this page until the code is entered again">Lock</button>
        </div>
      </header>

      <form class="board-login" id="fnd-login" hidden>
        <p>Enter the code to open the foundation list.</p>
        <div class="board-login__row">
          <input type="password" id="fnd-code" placeholder="Code" inputmode="numeric" autocomplete="off" />
          <button type="submit" class="req-admin-btn">Unlock</button>
        </div>
        <p class="req-msg" id="fnd-login-msg" aria-live="polite"></p>
      </form>

      <div id="fnd-app" hidden>
        <div class="fnd-top">
          <div class="fnd-tabs" id="fnd-tabs" role="tablist"></div>
          <section class="fnd-check" aria-label="Check a foundation">
            <label class="fnd-check__box" for="fnd-q">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="fnd-q" data-pt-search type="search" placeholder="Check a foundation before you call" autocomplete="off" autocapitalize="none" autocorrect="off" enterkeyhint="search" spellcheck="false" />
              <button type="button" class="fnd-check__clear" id="fnd-q-clear" hidden>Clear</button>
            </label>
          </section>
        </div>
        <div class="fnd-results" id="fnd-results" hidden></div>

        <div id="fnd-body">
          <section class="make-sheet fnd-sheet ptl-sheet" id="fnd-view-list"></section>

          <section id="fnd-view-cleanup" hidden></section>
          <section id="fnd-view-activity" hidden></section>
        </div>
      </div>
    </div>
  </div>

  <div class="req-drawer fnd-drawer" id="fnd-drawer" hidden>
    <div class="req-drawer__scrim" data-close></div>
    <aside class="req-drawer__panel" id="fnd-panel" aria-live="polite"></aside>
  </div>

  <div class="fnd-toast" id="fnd-toast" role="status" aria-live="polite"></div>
  <script is:inline src="/js/ptable.js?v=1"></script>
  <script is:inline src="/js/foundations.js?v=8"></script>
</App>
