---
// Help docs home: search across every article and video caption, the tour, what's new, topics and
// the newest videos. Articles live in src/content/help; videos in src/data/videos.json.
import { getCollection } from 'astro:content';
import App from '../../layouts/App.astro';
import { TOPICS, mins } from '../../data/help-topics';
import videos from '../../data/videos.json';

const docs = (await getCollection('help')).sort((a, b) => a.data.order - b.data.order);
const newest = [...videos].sort((a, b) => b.added.localeCompare(a.added)).slice(0, 4);
const I = (d: string) => `<svg class="h-i" viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
const ICON: Record<string, string> = {
  start: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>',
  work: '<path d="M3 13h5l2 3h4l2-3h5"/><path d="M5 5h14l2 8v6H3v-6z"/>',
  partners: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  numbers: '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
  ask: '<path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z"/>',
  blackbaud: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/>',
  help: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8"/><path d="M8 12h5"/>',
};
---
<App title="Help docs" crumb="Learn" nav="docs" description="How the Favor hub works: every tool, Ask Favor, the KPI dashboard, and training videos.">
  <div class="hd-home">
    <section class="hd-hero">
      <div class="hd-hero__text">
        <h1>How can we help?</h1>
        <p>Search every article and every word said in the training videos.</p>
      </div>
      <div class="hd-search" role="search">
        <svg class="h-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="hd-q" type="search" placeholder="Try: mileage, LYBUNT, connect Claude, print file" autocomplete="off" aria-label="Search the help docs" aria-controls="hd-results" />
        <kbd>/</kbd>
      </div>
      <div class="hd-results" id="hd-results" role="region" aria-live="polite" hidden></div>
      <div class="hd-hero__acts">
        <button type="button" class="h-btn h-btn--primary" data-tour-start>
          <Fragment set:html={I('<path d="M5 3.5 19 12l-6.5 1.4L10 20z"/>')} />Take the tour
        </button>
        <a class="h-btn h-btn--ghost" href="/help/videos/"><Fragment set:html={I('<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/>')} />Training videos</a>
        <button type="button" class="h-btn h-btn--ghost" data-feedback="help" data-title="What's missing from the help docs?">
          <Fragment set:html={I('<path d="M4 5h16v11H9l-5 4z"/>')} />Can't find it? Tell us
        </button>
      </div>
    </section>

    <section class="hd-foryou" id="hd-foryou" hidden>
      <div class="h-section"><h2>For your work</h2><p id="hd-foryou-who"></p></div>
      <div class="hd-cards" id="hd-foryou-list"></div>
    </section>

    <div class="h-section"><h2>Topics</h2><p>Every tool in the hub, step by step</p></div>
    <div class="hd-topics">
      {TOPICS.map((t) => (
        <section class="h-card hd-topic">
          <div class="hd-topic__head">
            <span class="hd-topic__icon"><Fragment set:html={I(ICON[t.id] || '')} /></span>
            <div><h3>{t.label}</h3><p>{t.blurb}</p></div>
          </div>
          <ul>
            {docs
              .filter((d) => d.data.topic === t.id)
              .map((d) => (
                <li data-for={d.data.for.join(' ')}>
                  <a href={`/help/${d.id}/`} data-doc={d.id} data-summary={d.data.summary}>{d.data.title}</a>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="h-section"><h2>Newest videos</h2><p><a class="h-link" href="/help/videos/">All {videos.length} videos</a></p></div>
    <div class="hd-vids">
      {newest.map((v) => (
        <a class="h-card hd-vid" href={`/help/videos/${v.slug}/`}>
          <span class="hd-vid__poster"><img src={`/api/videos/${v.slug}.jpg`} alt="" loading="lazy" /><em>{mins(v.seconds)}</em><i aria-hidden="true"></i></span>
          <b>{v.title}</b>
          <span>{v.summary}</span>
        </a>
      ))}
    </div>
  </div>
  <script is:inline src="/js/help.js?v=1" defer></script>
</App>
