---
// Gifts > Recurring is built in the React app (web/src/routes/gifts/recurring) and has no Astro twin. This note shows only to a person who
// left the new FavorOS with ?web=0 or opened the page with ?classic=1.
import App from '../../layouts/App.astro';
---
<App title="Recurring gifts" crumb="Gifts" nav="recurring" description="Every recurring gift schedule, with declines, past-due charges and stopped schedules.">
  <div class="h-card h-note">
    <h2 style="font-size:18px;font-weight:800">Recurring gifts opens in the new FavorOS</h2>
    <p class="h-lede" style="margin:6px 0 14px">This page was built only there. Press the button to switch back to the new FavorOS.</p>
    <a class="h-btn h-btn--primary h-btn--sm" href="/gifts/recurring/?web=1">Open Recurring</a>
  </div>
</App>
