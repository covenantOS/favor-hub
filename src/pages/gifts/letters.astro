---
// Gifts > Thank-you letters: the handwritten letters for gifts of $5,000 and up (HQTY), with where each letter stands. The same desk the
// Work Center had under Reports, on its own page in the gift flow. public/js/gifts-wc-shim.js stands in for the Work Center around it.
import App from '../../layouts/App.astro';
import '../../styles/work.css';
import '../../styles/work-edit.css';
import '../../styles/work-letters.css';
import '../../styles/qa-work.css';
import '../../styles/fix-work.css';
import '../../styles/crit-work.css';
import '../../styles/crit-work2.css';
import '../../styles/wc-fix.css';
import '../../styles/break-ui.css';
import '../../styles/gifts-pages.css';
---
<App full title="Thank-you letters" crumb="Gifts" nav="letters" description="Handwritten thank-you letters for gifts of $5,000 and up, with where each one stands.">
  <div class="wc-root gp-root" id="wc-root" aria-live="polite">
    <div id="view" data-wc-tab="hqty"><section class="h-card wc-sheet wc-skelrows" aria-busy="true"><div class="wc-skelbar"><i></i><i></i><i></i></div><div class="wc-skelrow"><i class="a"></i><i class="b"></i><i class="c"></i></div><div class="wc-skelrow"><i class="a"></i><i class="b"></i><i class="c"></i></div><div class="wc-skelrow"><i class="a"></i><i class="b"></i><i class="c"></i></div></section></div>
  </div>
  <div class="wc-toast" id="toast" role="status" aria-live="polite"></div>
  <div id="layer"></div>
  <script is:inline src="/js/gifts-wc-shim.js?v=1" defer></script>
  <script is:inline src="/js/work-letter.js?v=2" defer></script>
  <script is:inline src="/js/work-hqty.js?v=5" defer></script>
</App>
