---
import App from '../layouts/App.astro';
---
<App title="Page not found" crumb="Favor Hub" description="That page is not in the hub.">
  <div class="h-card h-note">
    <h2 style="font-size:18px;font-weight:800">That page isn't here</h2>
    <p class="h-lede" style="margin:6px 0 14px">The link may be old. Every tool is in the menu, and Search finds any of them.</p>
    <a class="h-btn h-btn--primary h-btn--sm" href="/">Go to Today</a>
  </div>
</App>
