---
// Meetings: the lobby and the room. All of it is drawn by /js/meet/room.js.
import App from '../../layouts/App.astro';
import '../../styles/meet.css';
import '../../styles/brain.css';
import { SPRITE } from '../brain/_icons';
---
<App title="Meeting" crumb="Meetings" nav="meet" bare description="A Favor meeting room.">
  <div class="bc-root" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true"><Fragment set:html={SPRITE} /></div>
  <div class="meet-room" id="meet-root" aria-live="polite"><div class="h-card h-skel" style="min-height:360px;margin:14px"></div></div>
  <script is:inline src="/js/brain-blocks.js?v=2"></script>
  <script is:inline type="module" src="/js/meet/room.js?v=2"></script>
</App>
