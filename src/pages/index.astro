---
import App from '../layouts/App.astro';
import { TODAY_FRAME } from '../data/today-skeleton';
// Today, redesigned 2026-10-14: one ranked Needs you list, the schedule, How Favor is doing, then role modules.
// today3.css lays it out; today2.css styles the meeting sheets; work-home.css and qa2-workhome.css the role modules' insides.
import '../styles/today2.css';
import '../styles/work-home.css';
import '../styles/qa2-workhome.css';
import '../styles/today3.css';
---
<App title="Today" nav="home" description="What is waiting on you across FavorOS.">
  <div class="td" id="td-root">
    <Fragment set:html={TODAY_FRAME} />
  </div>
  <script is:inline>
    // The greeting and the date are final text from the first paint (the first name this browser last saw).
    (function(){try{var h=+new Date().toLocaleString('en-US',{timeZone:'America/New_York',hour:'numeric',hour12:false})%24,p=h<12?'Good morning':h<17?'Good afternoon':'Good evening',n=localStorage.getItem('favor.hub.first.v1')||'';document.getElementById('t-hello').textContent=n?p+', '+n:p;document.getElementById('t-date').textContent=new Date().toLocaleDateString('en-US',{timeZone:'America/New_York',weekday:'long',month:'long',day:'numeric'});}catch(e){}})();
    // Your work (the role modules) starts reading now, while the page's scripts download.
    (function () {
      if (/[?&]as=/.test(location.search)) return;
      window.__whEarly = fetch('/api/hub/home', { credentials: 'same-origin', headers: { 'X-Hub-Request': '1' } }).then(function (r) { return r.json().then(function (j) { if (!r.ok || j.ok === false) { var e = new Error(j.message || 'Something went wrong. Try again.'); e.data = j; throw e; } return j; }); });
      window.__whEarly.catch(function () {});
    })();
  </script>
  <script is:inline src="/js/copy-stamp.js?v=2" defer></script>
  <script is:inline src="/js/today-snooze.js?v=2" defer></script>
  <script is:inline src="/js/chat/chat-view.js?v=2" defer></script>
  <script is:inline src="/js/today-inbox.js?v=5" defer></script>
  <script is:inline src="/js/today3.js?v=2" defer></script>
  <script is:inline src="/js/today-firstweek.js?v=1" defer></script>
  <script is:inline src="/js/wc-snap.js?v=2" defer></script>
  <script is:inline src="/js/work-home.js?v=18" defer></script>
  <script is:inline src="/js/today-giftday.js?v=1" defer></script>
</App>
