---
import App from '../layouts/App.astro';
import '../styles/r2-today.css';

const I = (d: string) => `<svg class="h-i" viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
const starts = [
  ['Make a request', 'Website, Blackbaud, design, print and more', '/requests/new', I('<path d="M12 5v14"/><path d="M5 12h14"/>')],
  ['Expense request', 'Purchases, travel and reimbursements', '/expenses/new', I('<path d="M6 2h12v20l-3-2-3 2-3-2-3 2z"/><path d="M9 7h6"/><path d="M9 11h6"/><path d="M9 15h4"/>')],
  ['Thank-you receipts', 'Print the letters waiting to go out', '/receipts/', I('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>')],
  ['Foundation prospects', 'Check a foundation before you call', '/foundations/', I('<path d="M3 21h18"/><path d="M5 21V10"/><path d="M19 21V10"/><path d="M9 21V10"/><path d="M15 21V10"/><path d="m2 10 10-6 10 6z"/>')],
];
---
<App title="Today" nav="home" description="What is waiting on you across the Favor hub.">
  <div class="r2t">
    <div class="r2t-hello">
      <section class="h-hello">
        <h1 id="t-hello">Welcome</h1>
        <p id="t-date"></p>
      </section>
      <div class="r2t-hello__r" id="t-now"></div>
    </div>
    <div class="h-card h-welcome" id="t-welcome" hidden>
      <span class="h-welcome__mark"><svg class="h-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v3"/><path d="M12 18v3"/><path d="M3 12h3"/><path d="M18 12h3"/><path d="m5.6 5.6 2.1 2.1"/><path d="m16.3 16.3 2.1 2.1"/><path d="m5.6 18.4 2.1-2.1"/><path d="m16.3 7.7 2.1-2.1"/></svg></span>
      <div><b>Welcome to the new hub</b><p>Every tool is in the menu on the left, and this page shows what is waiting on you. A two-minute tour, set up for your work, shows you around.</p></div>
      <div class="h-welcome__acts"><button type="button" class="h-btn h-btn--primary h-btn--sm" data-tour-start>Show me around</button><button type="button" class="h-x" id="t-welcome-x" aria-label="Hide this">&#x2715;</button></div>
    </div>

    <section>
      <div class="r2t-sec"><h2>Needs you</h2><span id="t-needs-meta"></span></div>
      <div class="r2t-needs" id="t-cards" aria-busy="true"><div class="r2t-skel"></div><div class="r2t-skel"></div><div class="r2t-skel"></div><div class="r2t-skel"></div></div>
      <p class="r2t-msg" id="d-sub" hidden></p>
    </section>

    <div class="r2t-row3" id="d-grid" aria-busy="true"><div class="r2t-skel r2t-skel--tall"></div><div class="r2t-skel r2t-skel--tall"></div><div class="r2t-skel r2t-skel--tall"></div></div>

    <section id="t-year-wrap" hidden>
      <div class="r2t-sec"><h2>Where the year stands</h2><span id="t-fresh"></span></div>
      <div class="r2t-yearrow">
        <div class="h-card r2t-year" id="t-year"></div>
        <div class="h-card r2t-mission" data-mission>
          <small>Since Favor began</small>
          <b>615,780</b>
          <p>people have come to Christ. Transformed hearts transform nations.</p>
        </div>
      </div>
    </section>

    <div class="r2t-lower">
      <div class="h-card">
        <div class="r2t-ch"><h3>What changed</h3><span>Last two weeks</span></div>
        <div class="r2t-feed" id="t-feed"></div>
        <button type="button" class="h-more r2t-more" id="t-feed-more" hidden>Show more</button>
      </div>
      <div class="r2t-stack">
        <div class="h-card" id="t-mine-card" hidden>
          <div class="r2t-ch"><h3>Your requests</h3><a class="h-link" href="/requests/">The board</a></div>
          <ul class="r2t-list" id="t-mine"></ul>
        </div>
        <div class="h-card">
          <div class="r2t-ch"><h3>Start something</h3></div>
          <div class="r2t-starts">
            {starts.map(([t, sub, href, ic]) => (
              <a class="r2t-start" href={href}>
                <span class="r2t-ico"><Fragment set:html={ic} /></span>
                <span><b>{t}</b><small>{sub}</small></span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  <script is:inline src="/js/copy-stamp.js?v=1" defer></script>
  <script is:inline src="/js/today-snooze.js?v=1" defer></script>
  <script is:inline src="/js/today.js?v=11" defer></script>
</App>
