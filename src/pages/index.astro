---
import App from '../layouts/App.astro';

const I = (d: string) => `<svg class="h-i" viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`;
const starts = [
  ['Make a request', 'Website, Blackbaud, design, print and more', '/requests/new', I('<path d="M12 5v14"/><path d="M5 12h14"/>')],
  ['Expense request', 'Purchases, travel and reimbursements', '/expenses/new', I('<path d="M6 2h12v20l-3-2-3 2-3-2-3 2z"/><path d="M9 7h6"/><path d="M9 11h6"/><path d="M9 15h4"/>')],
  ['Thank-you receipts', 'Print the letters waiting to go out', '/receipts/', I('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>')],
  ['Foundation prospects', 'Check a foundation before you call', '/foundations/', I('<path d="M3 21h18"/><path d="M5 21V10"/><path d="M19 21V10"/><path d="M9 21V10"/><path d="M15 21V10"/><path d="m2 10 10-6 10 6z"/>')],
];
const chev = I('<path d="m9 6 6 6-6 6"/>');
---
<App title="Today" nav="home" description="What is waiting on you across the Favor hub.">
  <section class="h-hello">
    <h1 id="t-hello">Welcome</h1>
    <p id="t-date"></p>
  </section>

  <div class="h-card h-welcome" id="t-welcome" hidden>
    <span class="h-welcome__mark"><svg class="h-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v3"/><path d="M12 18v3"/><path d="M3 12h3"/><path d="M18 12h3"/><path d="m5.6 5.6 2.1 2.1"/><path d="m16.3 16.3 2.1 2.1"/><path d="m5.6 18.4 2.1-2.1"/><path d="m16.3 7.7 2.1-2.1"/></svg></span>
    <div><b>Welcome to the new hub</b><p>Every tool is in the menu on the left, and this page shows what is waiting on you. Two minutes in Help shows you around.</p></div>
    <div class="h-welcome__acts"><a class="h-btn h-btn--primary h-btn--sm" href="/help/">Show me around</a><button type="button" class="h-x" id="t-welcome-x" aria-label="Hide this">&#x2715;</button></div>
  </div>

  <div class="h-section"><h2>Your day</h2><p id="d-sub">Blackbaud, your calendar, Drive and inbox</p></div>
  <div class="h-grid h-g3 h-day" id="d-grid" aria-busy="true"><div class="h-card h-skel"></div><div class="h-card h-skel"></div><div class="h-card h-skel"></div></div>

  <div class="h-section"><h2>Waiting on you</h2><p>Only what needs you today</p></div>
  <div class="h-grid h-g4" id="t-cards" aria-busy="true"><div class="h-card h-skel"></div><div class="h-card h-skel"></div></div>

  <div id="t-year-wrap" hidden>
    <div class="h-section"><h2>Where the year stands</h2><p id="t-fresh">The KPI dashboard's own numbers</p></div>
    <div class="h-grid h-g21">
      <div class="h-card h-year" id="t-year"></div>
      <div class="h-card h-mission" data-mission>
        <img src="/images/signin-field.jpg" alt="" />
        <div class="k">Since Favor began</div>
        <div class="n">615,780</div>
        <p>people have come to Christ. Transformed hearts transform nations.</p>
      </div>
    </div>
  </div>

  <div class="h-grid h-g21" style="margin-top:16px">
    <div class="h-card">
      <div class="h-card__head"><div class="h-card__title">Recent activity</div><div class="h-card__meta">Last two weeks</div></div>
      <div class="h-card__body"><ul class="h-feed" id="t-feed"></ul><button type="button" class="h-more" id="t-feed-more" hidden>Show more</button></div>
    </div>
    <div class="h-grid" style="align-content:start">
      <div class="h-card" id="t-mine-card" hidden>
        <div class="h-card__head"><div class="h-card__title">Your requests</div><div class="h-card__meta"><a class="h-link" href="/requests/">The board</a></div></div>
        <div class="h-card__body"><ul class="h-mine" id="t-mine"></ul></div>
      </div>
      <div class="h-card">
        <div class="h-card__head"><div class="h-card__title">Start something</div></div>
        <div class="h-card__body">
          <div class="h-starts">
            {starts.map(([t, sub, href, ic]) => (
              <a class="h-start" href={href}>
                <span class="h-start__icon"><Fragment set:html={ic} /></span>
                <span>{t}<small>{sub}</small></span>
                <Fragment set:html={chev} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  <script is:inline src="/js/today.js?v=4" defer></script>
</App>
