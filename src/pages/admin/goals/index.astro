---
// Admin > Fundraiser goals is built in the React app (web/src/routes/admin/goals) and has no Astro twin. This note shows only to a person who
// left the new FavorOS with ?web=0, opened the page with ?classic=1, or is not an admin.
import App from '../../../layouts/App.astro';
---
<App title="Fundraiser goals" crumb="Admin" nav="admin-goals" description="Each fundraiser's annual and quarterly goals, kept in FavorOS.">
  <div class="h-card h-note">
    <h2 style="font-size:18px;font-weight:800">Fundraiser goals is for admins, in the new FavorOS</h2>
    <p class="h-lede" style="margin:6px 0 14px">This page was built only there. An admin can press the button to switch back to the new FavorOS.</p>
    <a class="h-btn h-btn--primary h-btn--sm" href="/admin/goals/?web=1">Open Fundraiser goals</a>
  </div>
</App>
