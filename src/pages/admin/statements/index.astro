---
// Admin > Giving statements: the wording on every statement, the print file size, the copy folder and the email switch.
import App from '../../../layouts/App.astro';
import AdminHead from '../../../components/AdminHead.astro';
import '../../../styles/admin.css';
---
<App title="Giving statements settings" crumb="Admin" nav="admin-statements" description="The wording on every giving statement, the print file size and the email switch.">
  <div class="ad" id="ad-root">
    <AdminHead on="statements" title="Giving statements" lede="The wording on every giving statement, the print file size and the email switch. Michael Hinton and the CPA approve the final wording." />
    <p class="ad-card__meta"><a href="/statements/?tab=wording">Open the Statements page</a> to read the wording as it prints, or <a href="/api/statements/sample" target="_blank" rel="noopener">open a sample statement</a>.</p>
    <div class="ad" data-ad-area="statements" aria-busy="true"><div class="ad-tile h-skel" style="min-height:140px"></div></div>
  </div>
  <script is:inline src="/js/admin.js?v=1" defer></script>
  <script is:inline src="/js/admin-settings.js?v=4" defer></script>
</App>
