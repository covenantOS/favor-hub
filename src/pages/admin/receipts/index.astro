import AdminHead from '../../../components/AdminHead.astro';
import '../../../styles/admin.css';
import '../../../styles/q3-desk.css';
---
<App title="Receipts settings" crumb="Admin" nav="admin-receipts" description="The receipt window and the morning email line.">
  <div class="ad" id="ad-root">
    <AdminHead on="receipts" title="Receipts" lede="The receipt window and the morning email line." />
