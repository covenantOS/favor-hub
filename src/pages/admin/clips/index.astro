---
// Admin > Clips: Storage for each person and who can record.
import App from '../../../layouts/App.astro';
import AdminHead from '../../../components/AdminHead.astro';
import '../../../styles/admin.css';
---
<App title="Clips settings" crumb="Admin" nav="admin-clips" description="Storage for each person and who can record.">
  <div class="ad" id="ad-root">
    <AdminHead on="clips" title="Clips" lede="Storage for each person, the longest recording, the sharing default and who can record." />
    <div class="ad" data-ad-area="clips" aria-busy="true"><div class="ad-tile h-skel" style="min-height:140px"></div></div>
  </div>
  <script is:inline src="/js/admin.js?v=1" defer></script>
  <script is:inline src="/js/admin-settings.js?v=2" defer></script>
</App>
