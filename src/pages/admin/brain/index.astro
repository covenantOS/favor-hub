---
// Admin > Favor Brain: Access requests, the connect prompt, iWave caps, automatic titles and the question log.
import App from '../../../layouts/App.astro';
import AdminHead from '../../../components/AdminHead.astro';
import '../../../styles/admin.css';
---
<App title="Favor Brain settings" crumb="Admin" nav="admin-brain" description="Access requests, the connect prompt, iWave caps, automatic titles and the question log.">
  <div class="ad" id="ad-root">
    <AdminHead on="brain" title="Favor Brain" lede="Access requests, the connect prompt, automatic titles, iWave caps and every question asked." />
    <div class="ad" data-ad-area="brain" aria-busy="true"><div class="ad-tile h-skel" style="min-height:140px"></div></div>
  </div>
  <script is:inline src="/js/admin.js?v=1" defer></script>
  <script is:inline src="/js/admin-settings.js?v=1" defer></script>
</App>
