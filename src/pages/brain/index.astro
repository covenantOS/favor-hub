---
// The Favor Brain: a full-window chat. Your chats on the left, the conversation in the middle, a side
// panel for large tables on the right. Answers come from the Brain (mcp.favorintl.org/hub through
// /api/brain) as blocks, and public/js/brain.js draws each block as a component. The Brain keeps the
// access rules; this page only says who is asking. Admin lives at /brain/admin/.
import App from '../../layouts/App.astro';
import '../../styles/brain.css';
import { SPRITE } from './_icons';

const I = (n: string, c = 'h-i') => `<svg class="${c}" aria-hidden="true"><use href="#bci-${n}"/></svg>`;
---
<App title="Favor Brain" crumb="Work" nav="brain" bare description="Ask about partners, giving, team numbers, iWave ratings, grants and the manuals, here or from Claude or ChatGPT.">
  <div class="bc-root">
    <Fragment set:html={SPRITE} />
    <div class="bc-app" id="bc-app" data-ready="0">
      <aside class="bc-rail" id="bc-rail" aria-label="Your chats">
        <div class="bc-rail__in">
          <div style="display:flex;gap:6px;align-items:center">
            <button type="button" class="bc-new" id="bc-new"><Fragment set:html={I('edit')} />New chat<kbd>Ctrl Shift O</kbd></button>
            <button type="button" class="ib ib--bare" id="bc-rail-x" aria-label="Close your chats" style="display:none"><Fragment set:html={I('close')} /></button>
          </div>
          <div class="bc-find"><Fragment set:html={I('search')} /><input id="bc-find" type="search" placeholder="Search your chats" aria-label="Search your chats" autocomplete="off" /></div>
          <div class="bc-convs" id="bc-convs" role="list"></div>
          <div class="bc-rail__foot">
            <div class="bc-grp" style="padding-top:2px">Your sheets</div>
            <div class="bc-sheets-mini" id="bc-sheets"></div>
            <button type="button" class="bc-hint" data-act="connect"><Fragment set:html={I('link')} />Connect Claude or ChatGPT</button>
          </div>
        </div>
      </aside>

      <section class="bc-pane" aria-label="Chat">
        <div class="bc-bar">
          <button type="button" class="ib ib--bare" id="bc-railbtn" aria-label="Show your chats" aria-expanded="true" data-tip="Your chats"><Fragment set:html={I('rail')} /></button>
          <button type="button" class="ib ib--bare" id="bc-new2" aria-label="New chat" data-tip="New chat"><Fragment set:html={I('edit')} /></button>
          <button type="button" class="bc-bar__title" id="bc-title" aria-label="Rename this chat">New chat</button>
          <div class="bc-bar__right">
            <button type="button" class="ib ib--bare" id="bc-focus" aria-label="Hide the hub menu while chatting" aria-pressed="false" data-tip="Focus"><Fragment set:html={I('focus')} /></button>
            <button type="button" class="ib ib--bare" id="bc-menu" aria-label="More" aria-haspopup="menu" data-tip="More"><Fragment set:html={I('more')} /><span class="dot" id="bc-menudot" hidden></span></button>
          </div>
        </div>
        <div class="bc-scroll" id="bc-scroll">
          <div class="bc-col" id="bc-thread" aria-live="polite"></div>
        </div>
        <div class="bc-dock">
          <button type="button" class="h-btn h-btn--ghost h-btn--sm bc-jump" id="bc-jump"><Fragment set:html={I('caret')} />Latest answer</button>
          <div class="bc-dock__in">
            <form class="bc-compose" id="bc-compose">
              <label class="bc-sr" for="bc-input">Ask the Favor Brain</label>
              <textarea id="bc-input" rows="1" maxlength="600" placeholder="Ask about partners, giving, team numbers, iWave or the manuals" autocomplete="off"></textarea>
              <button type="submit" class="bc-send" id="bc-send" aria-label="Send" disabled><Fragment set:html={I('send')} /></button>
            </form>
            <div class="bc-fine"><i class="h-beta">Beta</i><span class="bc-fine__l">Answers can be off. Press <b>Not right</b> under an answer and your note reaches Will.</span><span class="bc-fine__s">Answers can be off. <b>Not right</b> tells Will.</span></div>
          </div>
        </div>
      </section>

      <aside class="bc-panel" id="bc-panel" aria-label="Side panel"><div class="bc-panel__in" id="bc-panel-in"></div></aside>
    </div>
  </div>
  <div class="bc-root" id="bc-portal">
    <div class="scrim" id="bc-scrim"></div>
    <div class="dlg" id="bc-dlg" role="dialog" aria-modal="true" aria-labelledby="bc-dlg-h"></div>
    <div class="toast" id="bc-toast" role="status" aria-live="polite"></div>
  </div>
  <script is:inline src="/js/brain-blocks.js?v=7"></script>
  <script is:inline src="/js/brain.js?v=10" defer></script>
</App>
