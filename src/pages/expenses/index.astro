---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/requests.css';
import '../../styles/expenses.css';
---
<Base
  title="Expense log - Favor Hub"
  description="Every expense request, its status, and the signed PDFs. Approver schedule lives here too."
>
  <Header />
  <main class="exp-page">
    <div class="container">
      <div class="exp-head">
        <div>
          <p class="make-kicker">Expenses</p>
          <h1>The expense <em>log</em></h1>
        </div>
        <div style="display:flex;gap:10px;align-items:center">
          <a class="req-submit" href="/expenses/new">Submit a request</a>
          <button type="button" class="req-ghost" id="exp-lock" hidden>Lock</button>
        </div>
      </div>
      <p class="exp-lede">Every request, its status, and the signed PDF. The approver schedule and the on-approval distribution list are managed here.</p>

      <div id="exp-locked">
        <form class="board-login" id="exp-login">
          <p>Enter the admin code to open the expense log.</p>
          <div class="board-login__row">
            <input type="password" id="exp-password" placeholder="Code" autocomplete="current-password" />
            <button type="submit" class="req-admin-btn">Unlock</button>
          </div>
          <p class="req-msg" id="exp-login-msg" aria-live="polite"></p>
        </form>
      </div>

      <div id="exp-admin" class="exp-admin-grid" hidden>
        <div class="make-sheet">
          <span class="exp-legend">Approver &amp; distribution</span>
          <div class="exp-settings-row">
            <label class="req-field"><span>Default approver name</span><input id="exp-set-name" maxlength="80" /></label>
            <label class="req-field"><span>Default approver email</span><input id="exp-set-email" maxlength="120" /></label>
            <button type="button" class="req-admin-btn" id="exp-set-save">Save</button>
          </div>
          <label class="req-field" style="margin-top:12px">
            <span>On approval, also email (comma separated)</span>
            <input id="exp-set-dist" maxlength="600" />
            <small>The requester and the approver always get the approval email. This list rides along.</small>
          </label>

          <span class="exp-legend">Mileage policy</span>
          <div class="exp-settings-row">
            <label class="req-field"><span>Rate (cents per mile)</span><input id="exp-set-mi-rate" type="number" min="1" max="500" /></label>
            <label class="req-field"><span>Deduction (miles per trip)</span><input id="exp-set-mi-ded" type="number" min="0" max="500" /></label>
            <button type="button" class="req-admin-btn" id="exp-set-mi-save">Save</button>
          </div>
          <small>Used by the mileage calculator on the request form. Update this when the IRS rate changes or the policy figure is confirmed.</small>
          <p class="req-msg" id="exp-set-mi-msg" aria-live="polite"></p>

          <span class="exp-legend">Out-of-office substitutes</span>
          <div class="exp-ovr-row">
            <label class="req-field"><span>From</span><input id="exp-ovr-start" type="date" /></label>
            <label class="req-field"><span>Through</span><input id="exp-ovr-end" type="date" /></label>
            <label class="req-field"><span>Name</span><input id="exp-ovr-name" maxlength="80" /></label>
            <label class="req-field"><span>Email</span><input id="exp-ovr-email" maxlength="120" /></label>
            <button type="button" class="req-admin-btn" id="exp-ovr-add">Add</button>
          </div>
          <ul class="exp-ovr-list" id="exp-ovr-list"></ul>
          <p class="req-msg" id="exp-set-msg" aria-live="polite"></p>

          <span class="exp-legend">Login code</span>
          <div class="exp-settings-row">
            <label class="req-field"><span>New code</span><input id="exp-code-new" type="password" maxlength="64" autocomplete="new-password" /></label>
            <label class="req-field"><span>Repeat new code</span><input id="exp-code-confirm" type="password" maxlength="64" autocomplete="new-password" /></label>
            <button type="button" class="req-admin-btn" id="exp-code-save">Update code</button>
          </div>
          <small>The code unlocks this log. The starting code is 1234. Change it here any time, and use the new code on the next sign-in.</small>
          <p class="req-msg" id="exp-code-msg" aria-live="polite"></p>
        </div>

        <div class="make-sheet">
          <span class="exp-legend">Requests</span>
          <div id="exp-log"></div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <script is:inline src="/js/expenses-admin.js?v=2"></script>
</Base>
