---
import App from '../../layouts/App.astro';
import '../../styles/requests.css';
import '../../styles/expenses.css';
---
<App title="Expense request" crumb="Work" nav="expense" description="Submit an expense request for approval and signature.">
  <div class="exp-page">
    <div class="container">
      <div class="exp-head">
        <div>
          <p class="make-kicker">Expenses</p>
          <h1>Expense <em>Request</em></h1>
        </div>
        <img src="/images/favor-primary.png" alt="Favor International" />
      </div>
      <p class="exp-lede">
        Submit expense requests for approval. Your approver signs electronically and everyone
        who needs the record gets the signed copy automatically. Paycom card expenses still go through Paycom.
      </p>

      <form class="make-sheet" id="exp-form" novalidate>
        <div class="exp-progress" id="exp-progress" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <p class="exp-stepname" id="exp-stepname"></p>
        <div class="exp-step" data-step="1" data-title="You and the trip">
        <span class="exp-legend">Who you are</span>
        <div class="exp-grid2">
          <label class="req-field"><span>Name</span><input id="exp-name" required maxlength="80" /></label>
          <label class="req-field"><span>Favor email</span><input id="exp-email" type="email" required maxlength="120" placeholder="you@favorintl.org" /></label>
        </div>

        <span class="exp-legend">Travel details (if any)</span>
        <div class="exp-grid2">
          <label class="req-field"><span>Dates</span><input id="exp-dates" maxlength="120" placeholder="Oct 6 &ndash; Oct 9" /></label>
          <label class="req-field"><span>City and state</span><input id="exp-city" maxlength="120" placeholder="Dallas, TX" /></label>
        </div>

        </div>

        <div class="exp-step" data-step="2" data-title="What it costs">
        <span class="exp-legend">Expenses</span>
        <div class="exp-items-head"><span>Description</span><span>Item</span><span>Est. amount</span><span></span></div>
        <div id="exp-rows"></div>
        <div class="exp-add-row">
          <button class="exp-add" id="exp-add" type="button">+ Add another expense</button>
          <button class="exp-add" id="exp-mi-toggle" type="button">+ Calculate mileage</button>
        </div>
        <div class="exp-mi-calc" id="exp-mi-calc" hidden>
          <span class="exp-legend">Mileage calculator</span>
          <label class="req-field"><span>Miles driven (total for the trip)</span><input id="exp-mi-miles" inputmode="decimal" placeholder="0" /></label>
          <p class="exp-mi-note" id="exp-mi-note">Loading the current mileage policy&hellip;</p>
          <div class="exp-mi-foot">
            <button type="button" class="req-admin-btn" id="exp-mi-add">Add to expenses</button>
            <button type="button" class="req-ghost" id="exp-mi-cancel">Cancel</button>
          </div>
        </div>
        <div class="exp-total"><span class="lbl">Total estimated</span><span class="val" id="exp-total-val">$0.00</span></div>

        </div>

        <div class="exp-step" data-step="3" data-title="Why it is needed">
        <span class="exp-legend">Reason</span>
        <label class="req-field">
          <span>Why is this needed?</span>
          <textarea id="exp-reason" required maxlength="4000" placeholder="For a trip, state its purpose. For a purchase, state what it supports and why it is needed."></textarea>
        </label>

        </div>

        <div class="exp-step" data-step="4" data-title="Sign and send">
        <span class="exp-legend">Affirmation</span>
        <label class="exp-affirm"><input type="checkbox" id="exp-affirm" /> I affirm that all of the above items are accurate to the best of my knowledge.</label>

        <span class="exp-legend">Your signature</span>
        <div id="exp-sig"></div>

        </div>

        <input class="req-hp" id="exp-hp" tabindex="-1" autocomplete="off" />
        <div class="exp-foot">
          <button class="req-submit exp-green" type="submit" id="exp-submit">Submit for approval</button>
          <p class="exp-note">Goes to the assigned approver for review and signature. You get a copy of the decision by email.</p>
        </div>
        <p class="req-msg" id="exp-msg" aria-live="polite"></p>
        <div class="exp-nav" id="exp-nav"><button type="button" class="h-btn h-btn--ghost" id="exp-back">Back</button><button type="button" class="h-btn h-btn--primary" id="exp-next">Next</button></div>
      </form>
      <script is:inline src="/js/expense-steps.js?v=1" defer></script>

      <div class="make-done" id="exp-done" hidden>
        <p class="make-kicker">Sent for approval</p>
        <h2><span id="exp-done-doc"></span> is on its way.</h2>
        <p><span id="exp-done-approver"></span> got an email with your request and will review and sign it. You get an email the moment it is decided.</p>
        <div class="make-done__actions">
          <a class="req-submit" href="/">Back to the dash</a>
          <button type="button" class="req-ghost" id="exp-again">Submit another</button>
        </div>
      </div>
    </div>
  </div>
  <script is:inline src="/js/expense-sign.js?v=1"></script>
  <script is:inline src="/js/expenses-new.js?v=1"></script>
  <script is:inline>
    // Signed in with Google: name and email come from the account. "Make a request" can pass the
    // words the person typed as ?reason=.
    (() => {
      const reason = new URLSearchParams(location.search).get('reason');
      const box = document.getElementById('exp-reason');
      if (reason && box && !box.value) box.value = reason;
      const fill = (d) => {
        const u = d && d.user;
        if (!u || u.via !== 'google') return;
        const name = document.getElementById('exp-name');
        const email = document.getElementById('exp-email');
        if (name && !name.value) name.value = u.name || '';
        if (email && !email.value) email.value = u.email || '';
      };
      if (window.FAVOR_HUB) fill(window.FAVOR_HUB);
      document.addEventListener('favor-hub', (e) => fill(e.detail));
    })();
  </script>
</App>
