---
import App from '../layouts/App.astro';
import SheetsButton from '../components/SheetsButton.astro';
import '../styles/requests.css';
import '../styles/qa-work.css';
import '../styles/crit-forms.css';
import '../styles/q3-desk.css';
---
<App full title="Requests" crumb="Work" nav="board" description="What the team has asked to change, what Will has approved, and what is finished.">
  <div class="board-page">
    <div class="container">
      <header class="board-intro">
        <div>
          <p class="make-kicker">Website &amp; apps</p>
          <h1>The <em>board</em></h1>
          
        </div>
        <div class="board-intro__actions">
          <a class="req-submit" href="/requests/new">Make a request</a>
          <span class="req-chip" id="req-count" hidden></span>
          <SheetsButton name="requests" />
          <button type="button" class="req-admin-btn" id="req-unlock" hidden>Sign in to review</button>
          <button type="button" class="req-ghost" id="req-lock" hidden title="Lock this page until the password is entered again">Lock</button>
        </div>
      </header>

      <form class="board-login" id="req-login" hidden>
        <p>Review password. Drag cards between columns once you are in.</p>
        <div class="board-login__row">
          <input type="password" id="req-password" placeholder="Password" autocomplete="current-password" />
          <button type="submit" class="req-admin-btn">Unlock</button>
        </div>
        <p class="req-msg" id="req-login-msg" aria-live="polite"></p>
      </form>

      <p class="board-hint" id="req-hint" hidden>Drag a card to move it</p>

      <div class="rt-filters" id="req-filters" role="group" aria-label="Show" hidden></div>
      <div class="req-tabs" id="req-tabs" role="tablist"></div>
      <div class="req-board" id="req-board"></div>
    </div>
  </div>

  <!-- The panel's scripts load on every page (layouts/App.astro); the board needs them before its own script runs. -->
  <script is:inline src="/js/chat/mention-input.js?v=1"></script>
  <script is:inline src="/js/request-tasks.js?v=2"></script>
  <script is:inline src="/js/request-drawer.js?v=1"></script>
  <script is:inline src="/js/requests-board.js?v=13"></script>
</App>
