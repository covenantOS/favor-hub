---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/requests.css';
---
<Base
  title="Request board - Favor Hub"
  description="What the team has asked to change, what Will has approved, and what is finished."
>
  <Header />
  <main class="board-page">
    <div class="container">
      <header class="board-intro">
        <div>
          <p class="make-kicker">Website &amp; apps</p>
          <h1>The <em>board</em></h1>
          <p>Inbox waits for Will. Approved is what agents may build. In motion is claimed. Done is shipped.</p>
        </div>
        <div class="board-intro__actions">
          <a class="req-submit" href="/requests/new">Make a request</a>
          <span class="req-chip" id="req-count">Loading</span>
          <button type="button" class="req-admin-btn" id="req-unlock">Sign in to review</button>
          <button type="button" class="req-ghost" id="req-lock" hidden>Lock</button>
        </div>
      </header>

      <form class="board-login" id="req-login" hidden>
        <p>Review password. Drag cards between columns once you are in.</p>
        <div class="board-login__row">
          <input type="password" id="req-password" placeholder="Password" autocomplete="current-password" />
          <button type="submit" class="req-admin-btn">Unlock</button>
        </div>
        <p class="req-msg" id="req-login-msg" aria-live="polite"></p>
      </form>

      <p class="board-hint" id="req-hint" hidden>Drag a card onto Approve, In motion, or Done. Click a card for the full note.</p>

      <div class="req-tabs" id="req-tabs" role="tablist"></div>
      <div class="req-board" id="req-board"></div>
    </div>
  </main>

  <div class="req-drawer" id="req-drawer" hidden>
    <div class="req-drawer__scrim" data-close></div>
    <aside class="req-drawer__panel" id="req-drawer-panel"></aside>
  </div>

  <Footer />
  <script is:inline src="/js/requests-board.js?v=3"></script>
</Base>
