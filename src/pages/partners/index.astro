---
import App from '../../layouts/App.astro';
import '../../styles/ptable.css';
import '../../styles/partners-dir.css';
---
<App full title="All partners" crumb="Partners" nav="partners-all" description="Every partner record in Blackbaud, givers or not: search, filter, sort, save a view and export.">
  <div class="pd-root" id="pd-root" aria-live="polite">
    <section class="h-card pd-sheet" aria-label="All partners" aria-busy="true">
      <div class="pt-bar"><div class="h-skel" style="height:32px;width:100%;border-radius:8px"></div></div>
      <div class="h-skel" style="height:620px;border-radius:0 0 18px 18px"></div>
    </section>
  </div>
  <div class="pd-bulk" id="pd-bulk" role="region" aria-label="Selected partners"></div>
  <script is:inline>
    // The first page and the menus start loading while the page's scripts download.
    (function () {
      var h = { credentials: 'same-origin', headers: { 'X-Hub-Request': '1' } };
      var qs = location.search ? location.search.slice(1) + '&' : '';
      window.__pdEarly = fetch('/api/partners?' + qs + 'menus=1', h).then(function (r) { return r.json(); });
      window.__pdEarly.catch(function () {});
    })();
  </script>
  <script is:inline src="/js/ptable.js?v=1" defer></script>
  <script is:inline src="/js/partners-dir.js?v=1" defer></script>
</App>
