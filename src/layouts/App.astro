---
// The hub's frame: sidebar, top bar, and the page. Every hub page uses it except the sign-in page.
// hub-shell.js fills in who is signed in, the counts beside each tool, and the sections that only
// some people see (the KPI dashboard, the expense log).
import '../styles/global.css';
import '../styles/app.css';
import '../styles/feel.css';
import '../styles/elevate.css';
import '../styles/phone.css';
import '../styles/settle.css';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  crumb?: string;
  nav?: string;
  wide?: boolean;
  /** Use the whole width beside the sidebar (boards and long tables), keeping the page padding. */
  full?: boolean;
  description?: string;
}

const { title, crumb = 'Favor Hub', nav = '', wide = false, full = false, description = 'Favor International staff hub.' } = Astro.props;

const ICONS: Record<string, string> = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  inbox: '<path d="M3 13h5l2 3h4l2-3h5"/><path d="M5 5h14l2 8v6H3v-6z"/>',
  receipt: '<path d="M6 2h12v20l-3-2-3 2-3-2-3 2z"/><path d="M9 7h6"/><path d="M9 11h6"/><path d="M9 15h4"/>',
  log: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8"/><path d="M8 12h8"/><path d="M8 16h5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  landmark: '<path d="M3 21h18"/><path d="M5 21V10"/><path d="M19 21V10"/><path d="M9 21V10"/><path d="M15 21V10"/><path d="m2 10 10-6 10 6z"/>',
  chart: '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
  news: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10"/><path d="M7 12h10"/><path d="M7 16h6"/>',
  file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/>',
  ext: '<path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  out: '<path d="M15 4h4v16h-4"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h10"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  brain: '<path d="M12 3l1.8 4.6L18.5 9l-4.7 1.4L12 15l-1.8-4.6L5.5 9l4.7-1.4z"/><path d="M18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/>',
  help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14"/><path d="M12 17.5h.01"/>',
  book: '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 21a2 2 0 0 1 2-2h13v2"/><path d="M8 7h7"/><path d="M8 11h5"/>',
  play: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/>',
  chat: '<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8"/><path d="M8 12h5"/>',
  sound: '<path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7"/><path d="M19 6a8.5 8.5 0 0 1 0 12"/>',
  mute: '<path d="M4 9h4l5-4v14l-5-4H4z"/><path d="m17 9 5 6"/><path d="m22 9-5 6"/>',
  work: '<path d="M4 7h4"/><path d="M4 12h4"/><path d="M4 17h4"/><path d="m11 7 1.5 1.5L15 6"/><path d="m11 12 1.5 1.5L15 11"/><path d="M11 17h9"/><path d="M17 7h3"/><path d="M17 12h3"/>',
};
const icon = (name: string, cls = 'h-i') => `<svg class="${cls}" viewBox="0 0 24 24" aria-hidden="true">${ICONS[name] || ''}</svg>`;

type Item = { id?: string; label: string; href: string; icon: string; count?: string; need?: string; ext?: boolean; sub?: boolean; team?: string; beta?: boolean };
const GROUPS: Array<{ label: string | null; need?: string; items: Item[] }> = [
  { label: null, items: [{ id: 'home', label: 'Today', href: '/', icon: 'home' }] },
  {
    label: 'Work',
    items: [
      { id: 'new', label: 'Make a request', href: '/requests/new', icon: 'plus' },
      { id: 'board', label: 'Request board', href: '/requests/', icon: 'inbox', count: 'inbox' },
      { id: 'work', label: 'Work Center', href: '/work/', icon: 'work', count: 'workWaiting', need: 'workCenter' },
      { id: 'expense', label: 'Expense request', href: '/expenses/new', icon: 'receipt' },
      { id: 'expenses', label: 'Expense log', href: '/expenses/', icon: 'log', count: 'expensesWaiting', need: 'expenseLog' },
      { id: 'receipts', label: 'Thank-you receipts', href: '/receipts/', icon: 'mail', count: 'receiptsLeft' },
      { id: 'foundations', label: 'Foundation prospects', href: '/foundations/', icon: 'landmark' },
      { id: 'brain', label: 'Favor Brain', href: '/brain/', icon: 'brain', beta: true },
      { id: 'brain-admin', label: 'Brain admin', href: '/brain/admin/', icon: 'brain', sub: true, need: 'admin', count: 'brainRequests' },
    ],
  },
  {
    label: 'KPI dashboard',
    need: 'kpi',
    items: [
      { id: 'kpi', label: 'Executive', href: '/dashboard/', icon: 'chart' },
      { id: 'kpi-rdds', label: 'RDD team', href: '/dashboard/?page=%2Frdds', icon: 'chart', sub: true, team: 'rdd' },
      { id: 'kpi-pc', label: 'Partner Care', href: '/dashboard/?page=%2Fpc', icon: 'chart', sub: true, team: 'pc' },
      { id: 'kpi-ce', label: 'Church Engagement', href: '/dashboard/?page=%2Fce', icon: 'chart', sub: true, team: 'ce' },
      { id: 'kpi-grants', label: 'Grants', href: '/dashboard/?page=%2Fgrants', icon: 'chart', sub: true, team: 'grants' },
      { id: 'kpi-marketing', label: 'Marketing', href: '/dashboard/?page=%2Fmarketing', icon: 'chart', sub: true, team: 'marketing' },
      { id: 'kpi-definitions', label: 'Definitions', href: '/dashboard/?page=%2Fdefinitions', icon: 'chart', sub: true },
    ],
  },
  {
    label: 'Tools',
    items: [
      { label: 'Blackbaud', href: 'https://app.blackbaud.com/signin/?redirectUrl=https://app.blackbaud.com/', icon: 'ext', ext: true },
      { label: 'GoHighLevel', href: 'https://my.favor.international', icon: 'ext', ext: true },
      { label: 'Paycom', href: 'https://www.paycomonline.net/v4/ee/web.php/app/login', icon: 'ext', ext: true },
      { label: 'Media folder', href: 'https://drive.google.com/drive/folders/1vJQn3vvoxKWKjW4ZmYDDfPZ0Li_w8-ZU', icon: 'ext', ext: true },
      { label: 'favorintl.org', href: 'https://www.favorintl.org', icon: 'ext', ext: true },
    ],
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/images/favor-icon.png" />
    <link rel="apple-touch-icon" href="/images/favor-icon.png" />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-500.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f4efe0" />
    <title>{title} - Favor Hub</title>
    <meta name="description" content={description} />
  </head>
  <body class="h-body" data-nav={nav}>
    <a class="h-skip" href="#h-content">Skip to the page</a>
    <div class="h-app" id="h-app">
      <aside class="h-side" id="h-side" aria-label="Hub">
        <a class="h-brand" href="/" data-astro-prefetch="hover" aria-label="Favor Hub home"><img src="/images/favor-logo-color.png" alt="Favor International" /><span>Hub</span></a>
        <button type="button" class="h-search" data-cmdk-open><Fragment set:html={icon('search')} />Search<kbd>Ctrl K</kbd></button>
        <nav>
          {GROUPS.map((g) => (
            <div data-need={g.need || undefined} hidden={g.need ? true : undefined}>
              {g.label && <div class="h-nav__label">{g.label}</div>}
              {g.items.map((it) =>
                it.ext ? (
                  <a class="h-nav__item" href={it.href} target="_blank" rel="noopener noreferrer">{it.label}<Fragment set:html={icon('ext', 'h-i h-nav__ext')} /></a>
                ) : (
                  <a
                    class={`h-nav__item${it.sub ? ' h-nav__sub' : ''}${it.id === nav ? ' is-on' : ''}`}
                    href={it.href}
                    data-astro-prefetch="hover"
                    data-nav-id={it.id}
                    data-need={it.need || undefined}
                    data-kpi-team={it.team || undefined}
                    data-kpi-page={it.href.startsWith('/dashboard/') ? decodeURIComponent((it.href.split('page=')[1] || '%2F')) : undefined}
                    hidden={it.need || it.team ? true : undefined}
                    aria-current={it.id === nav ? 'page' : undefined}
                  >
                    {!it.sub && <Fragment set:html={icon(it.icon)} />}
                    {it.label}
                    {it.beta && <em class="h-beta">Beta</em>}
                    {it.count && <span class="h-nav__count" data-count={it.count} hidden></span>}
                  </a>
                )
              )}
            </div>
          ))}
        </nav>
        <button type="button" class="h-nav__item h-nav__help" id="h-help" data-tour-start title="A guided tour of the hub, set up for your work"><Fragment set:html={icon('help')} />Help and what's new<span class="h-dot" aria-hidden="true"></span></button>
        <div class="h-learn">
          {[
            { id: 'docs', label: 'Help docs', href: '/help/', icon: 'book' },
            { id: 'videos', label: 'Videos', href: '/help/videos/', icon: 'play' },
            { id: 'feedback', label: 'Feedback', href: '/feedback/', icon: 'chat', count: 'feedback' },
          ].map((it) => (
            <a href={it.href} data-astro-prefetch="hover" data-nav-id={it.id} class={it.id === nav ? 'is-on' : undefined} aria-current={it.id === nav ? 'page' : undefined}>
              {it.label}
              {it.count && <span class="h-nav__count" data-count={it.count} hidden></span>}
            </a>
          ))}
        </div>
        <div class="h-side__foot" id="h-foot" hidden>
          <span class="h-avatar" id="h-avatar"></span>
          <div class="h-who"><b id="h-name"></b><span id="h-email"></span></div>
          <button type="button" class="h-out h-sound" data-sound-switch aria-pressed="true"><Fragment set:html={icon('sound', 'h-i h-sound__on')} /><Fragment set:html={icon('mute', 'h-i h-sound__off')} /></button>
          <button type="button" class="h-out" id="h-out" title="Sign out" aria-label="Sign out"><Fragment set:html={icon('out')} /></button>
        </div>
      </aside>
      <script is:inline>
        // Paint the menu the way this person last saw it, before the first frame, so entries never pop in
        // after the sign-in check. hub-shell.js refreshes the saved copy on every page.
        window.hubApplyNav = function (d) {
          var $ = function (id) { return document.getElementById(id); };
          var u = d.user || {};
          if (u.via === 'google' && $('h-foot')) {
            var name = u.name || u.email || '';
            $('h-name').textContent = name;
            $('h-email').textContent = u.email || '';
            var av = $('h-avatar');
            if (u.picture) {
              av.innerHTML = '';
              var img = document.createElement('img');
              img.alt = ''; img.referrerPolicy = 'no-referrer'; img.src = u.picture;
              av.appendChild(img);
            } else {
              av.textContent = String(name).split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0].toUpperCase(); }).join('');
            }
            $('h-foot').hidden = false;
          }
          var access = d.access || {};
          document.documentElement.classList.toggle('has-kpi', !!access.kpi);
          document.querySelectorAll('[data-need]').forEach(function (el) { if (access[el.dataset.need]) el.hidden = false; });
          var teams = d.kpiTeams || [];
          document.querySelectorAll('[data-kpi-team]').forEach(function (el) { el.hidden = !access.kpi || teams.indexOf(el.dataset.kpiTeam) < 0; });
          var counts = d.counts || {};
          document.querySelectorAll('[data-count]').forEach(function (el) {
            var n = Number(counts[el.dataset.count]) || 0;
            el.hidden = !n;
            el.textContent = n.toLocaleString('en-US');
            el.classList.toggle('h-nav__count--warn', el.dataset.count === 'receiptsLeft');
          });
        };
        try {
          var saved = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null');
          if (saved) window.hubApplyNav(saved);
          if (!localStorage.getItem('favor.hub.welcome.v1')) document.documentElement.classList.add('show-welcome');
        } catch (e) {}
      </script>

      <div class="h-main">
        <header class="h-top">
          <button type="button" class="h-top__menu" id="h-menu" aria-label="Open the menu" aria-controls="h-side" aria-expanded="false"><Fragment set:html={icon('menu')} /></button>
          <div>
            <div class="h-top__crumb">{crumb}</div>
            <div class="h-top__title">{title}</div>
          </div>
          <div class="h-top__right">
            <button type="button" class="h-top__search" data-cmdk-open aria-label="Search the hub"><Fragment set:html={icon('search')} /></button>
            <slot name="actions" />
            <button type="button" class="h-btn h-btn--ghost h-fb" id="h-fb" data-feedback="hub" title="Tell Will what's wrong, confusing or worth adding"><Fragment set:html={icon('chat')} /><span class="h-lbl">Feedback</span></button>
            {nav !== 'new' && (
              <a class="h-btn h-btn--primary" href="/requests/new"><Fragment set:html={icon('plus')} /><span class="h-lbl">Make a request</span></a>
            )}
          </div>
        </header>
        <main id="h-content" tabindex="-1" class={wide ? 'h-page h-page--wide' : full ? 'h-page h-page--full' : 'h-page'}>
          <slot />
        </main>
      </div>
    </div>
    <CommandPalette />
    <script is:inline src="/js/hub-shell.js?v=4" defer></script>
    <script>
      import '../scripts/hub';
    </script>
  </body>
</html>
