        </header>
        <script is:inline>
          // The top bar comes after the menu script above, so the saved sections (reminders bell, clips buttons) are applied to it here, before its first paint.
          try { var s2 = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); if (s2) window.hubApplyNav(s2); else if (document.documentElement.classList.contains('nav-pending')) { var tp0 = document.getElementById('h-tabs'); if (tp0) tp0.hidden = false; } if (localStorage.getItem('favor.hub.gate.v1') === '1') { var hb = document.getElementById('pp-headsearch'); if (hb) hb.hidden = false; } } catch (e) {}
        </script>
