---
// The hub's frame: sidebar, top bar, and the page. Every hub page uses it except the sign-in page.
// hub-shell.js fills in who is signed in, the counts beside each tool, and the sections that only
// some people see (the KPI dashboard, the expense log).
import '../styles/global.css';
import '../styles/app.css';
import '../styles/feel.css';
import '../styles/elevate.css';
import '../styles/phone.css';
import '../styles/settle.css';
import '../styles/clipbtn.css';
import '../styles/partner.css';
import '../styles/wc-bell.css';
import '../styles/color.css';
import '../styles/gifts.css';
import '../styles/nav.css';
import '../styles/round2.css';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  crumb?: string;
  nav?: string;
  wide?: boolean;
  /** Use the whole width beside the sidebar (boards and long tables), keeping the page padding. */
  full?: boolean;
  /** The page lays itself out (the Favor Brain chat): no page padding, width limit or h-page rules. */
  bare?: boolean;
  description?: string;
}

const { title, crumb = 'Favor Hub', nav = '', wide = false, full = false, bare = false, description = 'Favor International staff hub.' } = Astro.props;

import { icon } from '../data/icons';
import { AREAS, SWAP_PATHS, resolveNav } from '../data/areas';
import NavArea from '../components/NavArea.astro';
import NavTabs from '../components/NavTabs.astro';
import NavBar from '../components/NavBar.astro';

const found = resolveNav(nav);
const curArea = found ? found.area.id : '';
const crumbText = found ? found.area.label : crumb;
const mainAreas = AREAS.filter((a) => !a.foot);
const footAreas = AREAS.filter((a) => a.foot);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/images/favor-icon.png" />
    <link rel="apple-touch-icon" href="/images/favor-icon.png" />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-500.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f4efe0" />
    <script is:inline src="/js/sheets.js?v=1"></script>
    <script is:inline src="/js/thank.js?v=2" defer></script>
    <script is:inline src="/js/prep.js?v=1" defer></script>
    <script is:inline src="/js/partner.js?v=7" defer></script>
    <script type="speculationrules" is:inline set:html={JSON.stringify({ prerender: [{ where: { and: [{ selector_matches: '.h-side nav a[data-astro-prefetch], .h-tabs a[data-astro-prefetch]' }, { not: { href_matches: '/dashboard/*' } }, { not: { href_matches: '/brain/admin/*' } }] }, eagerness: 'moderate' }] })}></script>
    <script is:inline>
      // The menu opens the way this person left it (slim rail or full sidebar) before the first frame.
      try { var np = JSON.parse(localStorage.getItem('favor.hub.nav.prefs.v1') || '{}'); var nu = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); var pr = np[(nu && nu.user && nu.user.email) || '_'] || np._ || {}; if (pr.wide && matchMedia('(min-width: 1280px)').matches) document.documentElement.classList.add('nav-wide'); } catch (e) {}
    </script>
    <title>{title} - Favor Hub</title>
    <meta name="description" content={description} />
  </head>
  <body class="h-body" data-nav={nav} data-area={curArea || undefined}>
    <a class="h-skip" href="#h-content">Skip to the page</a>
    <div class="h-app" id="h-app">
      <aside class="h-side" id="h-side" aria-label="Hub">
        <button type="button" class="h-side__tog" id="h-wide" aria-pressed="false" aria-label="Expand the menu" title="Expand the menu (press the backslash key)"><Fragment set:html={icon('chev')} /></button>
        <div class="h-side__in">
          <a class="h-brand" href="/" data-astro-prefetch="hover" aria-label="Favor Hub home"><img class="h-brand__full" src="/images/favor-logo-color.png" alt="Favor International" /><img class="h-brand__mark" src="/images/favor-icon.png" alt="Favor International" /><span>Hub</span></a>
          <button type="button" class="h-search" data-cmdk-open><Fragment set:html={icon('search')} /><span class="h-search__t">Search</span><kbd>Ctrl K</kbd></button>
          <div class="h-pins" id="h-pins" hidden><div class="h-nav__label">Pinned</div><div class="h-pins__list" id="h-pins-list"></div></div>
          <nav class="h-areas" aria-label="Areas">
            {mainAreas.map((a) => <NavArea area={a} nav={nav} curArea={curArea} />)}
          </nav>
          <div class="h-areas h-areas--foot">
            {footAreas.map((a) => <NavArea area={a} nav={nav} curArea={curArea} />)}
          </div>
          <div class="h-side__foot" id="h-foot" hidden>
            <button type="button" class="h-acct" id="h-acct" aria-haspopup="menu" aria-expanded="false" aria-controls="h-acctmenu" title="Your account">
              <span class="h-avatar" id="h-avatar"></span>
              <span class="h-who"><b id="h-name"></b><span id="h-email"></span></span>
            </button>
            <div class="h-acctmenu" id="h-acctmenu" role="menu" hidden>
              <a role="menuitem" href="/clips/" data-astro-prefetch="hover"><Fragment set:html={icon('clips')} />My clips</a>
              <button type="button" role="menuitem" data-clip-record><Fragment set:html={icon('camera')} />Record a clip</button>
            </div>
            <button type="button" class="h-out h-sound" data-sound-switch aria-pressed="true"><Fragment set:html={icon('sound', 'h-i h-sound__on')} /><Fragment set:html={icon('mute', 'h-i h-sound__off')} /></button>
            <button type="button" class="h-out" id="h-out" title="Sign out" aria-label="Sign out"><Fragment set:html={icon('out')} /></button>
          </div>
        </div>
      </aside>
      <div class="h-scrim" id="h-scrim" aria-hidden="true"></div>
      <script is:inline>
        // Paint the menu the way this person last saw it, before the first frame, so entries never pop in
        // after the sign-in check. hub-shell.js refreshes the saved copy on every page.
        window.hubGate = function () {
          if (!window.__hubGateP) window.__hubGateP = fetch('/api/work/gate', { credentials: 'same-origin', headers: { 'X-Hub-Request': '1' } })
            .then(function (r) { return r.json().then(function (j) { if (!r.ok || j.ok === false) throw new Error(j.message || 'gate'); return j; }); })
            .catch(function (e) { window.__hubGateP = null; throw e; });
          return window.__hubGateP;
        };
        // Areas with nothing this person may open disappear; the rail, the tab row and the phone bar follow.
        window.hubNavLayout = function () {
          var q = function (sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); };
          var prefs = {};
          try { var np = JSON.parse(localStorage.getItem('favor.hub.nav.prefs.v1') || '{}'); var nu = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); prefs = np[(nu && nu.user && nu.user.email) || '_'] || np._ || {}; } catch (e) {}
          var last = prefs.last || {};
          var sums = {};
          q('.h-area').forEach(function (a) {
            var id = a.dataset.area;
            var pages = q('.h-pg:not([hidden])', a);
            a.hidden = !pages.length;
            a.classList.toggle('is-single', pages.length === 1);
            var n = 0, warn = false;
            pages.forEach(function (pg) { var c = pg.querySelector('[data-count]:not([hidden])'); if (c) { n += Number(String(c.textContent).replace(/,/g, '')) || 0; if (c.classList.contains('h-nav__count--warn')) warn = true; } });
            sums[id] = { n: n, warn: warn };
            var target = pages[0] ? pages[0].querySelector('a') : null;
            var mem = last[id] && q('.h-pg:not([hidden]) a[data-nav-id="' + last[id] + '"]', a)[0];
            var href = (mem || target) ? (mem || target).getAttribute('href') : a.querySelector('.h-area__link').dataset.default;
            q('[data-area-link="' + id + '"]').forEach(function (l) { if (!l.closest('.h-area--pop')) l.setAttribute('href', href); });
          });
          q('[data-sum]').forEach(function (el) {
            var s = sums[el.dataset.sum];
            if (el.dataset.sum === 'more') { s = { n: 0, warn: false }; q('#h-bar [data-bar][hidden]').forEach(function (b) { var t = sums[b.dataset.bar]; if (t) s.n += t.n; }); ['admin', 'help'].forEach(function (k) { if (sums[k]) s.n += sums[k].n; }); }
            var n = s ? s.n : 0;
            el.hidden = !n;
            el.textContent = n > 99 ? '99+' : n.toLocaleString('en-US');
            el.classList.toggle('h-nav__count--warn', !!(s && s.warn));
          });
          var tabs = document.getElementById('h-tabs');
          if (tabs) tabs.hidden = q('.h-tab:not([hidden])', tabs).length < 2;
          var bar = q('#h-bar [data-bar]');
          var vis = bar.filter(function (b) { var a = document.querySelector('.h-area[data-area="' + b.dataset.bar + '"]'); return a && !a.hidden; });
          vis.sort(function (x, y) { return Number(x.dataset.rank) - Number(y.dataset.rank); });
          bar.forEach(function (b) { b.hidden = vis.indexOf(b) < 0 || vis.indexOf(b) > 4; });
          var cur = document.querySelector('.h-area.is-cur');
          var more = document.getElementById('h-bar-more');
          if (more) more.classList.toggle('is-on', !!cur && !bar.some(function (b) { return !b.hidden && b.dataset.bar === cur.dataset.area; }));
        };
        window.hubApplyNav = function (d) {
          var $ = function (id) { return document.getElementById(id); };
          var u = d.user || {};
          if (u.via === 'google' && $('h-foot')) {
            var name = u.name || u.email || '';
            $('h-name').textContent = name;
            $('h-email').textContent = u.email || '';
            var av = $('h-avatar');
            if (u.picture) {
              av.innerHTML = '';
              var img = document.createElement('img');
              img.alt = ''; img.referrerPolicy = 'no-referrer'; img.src = u.picture;
              av.appendChild(img);
            } else {
              av.textContent = String(name).split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0].toUpperCase(); }).join('');
            }
            $('h-foot').hidden = false;
          }
          var access = d.access || {};
          document.documentElement.classList.toggle('has-kpi', !!access.kpi);
          document.documentElement.classList.toggle('has-wc', !!access.workCenter);
          document.documentElement.classList.toggle('has-clips', !!access.clips);
          document.querySelectorAll('[data-need]').forEach(function (el) { if (access[el.dataset.need]) el.hidden = false; });
          var teams = d.kpiTeams || [];
          document.querySelectorAll('[data-kpi-team]').forEach(function (el) { el.hidden = !access.kpi || teams.indexOf(el.dataset.kpiTeam) < 0; });
          var counts = d.counts || {};
          document.querySelectorAll('[data-count]').forEach(function (el) {
            var n = Number(counts[el.dataset.count]) || 0;
            el.hidden = !n;
            el.textContent = n.toLocaleString('en-US');
            el.classList.toggle('h-nav__count--warn', el.dataset.count === 'receiptsLeft');
          });
          if (window.hubNavLayout) window.hubNavLayout();
        };
        try {
          var saved = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null');
          if (saved) window.hubApplyNav(saved);
          if (localStorage.getItem('favor.hub.gate.v1') === '1') document.documentElement.classList.add('has-gate');
          if (!localStorage.getItem('favor.hub.welcome.v1')) document.documentElement.classList.add('show-welcome');
        } catch (e) {}
      </script>

      <div class="h-main">
        <header class="h-top">
          <button type="button" class="h-top__menu" id="h-menu" aria-label="Open the menu" aria-controls="h-side" aria-expanded="false"><Fragment set:html={icon('menu')} /></button>
          {found && <span class="h-tile" id="h-tile" aria-hidden="true"><Fragment set:html={icon(found.area.icon)} /></span>}
          <div class="h-top__head">
            <div class="h-top__crumb">{crumbText}</div>
            <div class="h-top__title">{found ? found.area.label : title}</div>
          </div>
          <div class="h-top__tabs" id="h-tabs-slot">{found && <NavTabs area={found.area} nav={nav} />}</div>
          <div class="h-top__right">
            <div class="pp-headsearch pv-find" id="pp-headsearch" hidden><label class="pv-find__box"><Fragment set:html={icon('search')} /><input type="search" placeholder="Find a partner" autocomplete="off" aria-label="Find a partner" /><kbd>Ctrl K</kbd></label><ul class="pv-find__list" role="listbox" hidden></ul></div>
            <button type="button" class="h-top__search" data-cmdk-open aria-label="Search the hub"><Fragment set:html={icon('search')} /></button>
            <span class="h-top__actions" id="h-actions"><slot name="actions" /></span>
            <button type="button" class="h-top__cam wm-bell" id="wm-bell" data-need="workCenter" hidden aria-haspopup="dialog" aria-expanded="false" aria-label="Reminders" title="Reminders"><Fragment set:html={icon('bell')} /><em></em></button>
            <a class="h-top__cam h-top__lib" id="clip-lib" href="/clips/" data-need="clips" hidden aria-label="My clips" title="My clips"><Fragment set:html={icon('clips')} /></a>
            <button type="button" class="h-top__cam" id="clip-cam" data-need="clips" hidden aria-haspopup="dialog" aria-expanded="false" aria-label="Record a clip" title="Record a clip"><Fragment set:html={icon('camera')} /></button>
            <button type="button" class="h-btn h-btn--ghost h-fb" id="h-fb" data-feedback="hub" title="Tell Will what's wrong, confusing or worth adding"><Fragment set:html={icon('chat')} /><span class="h-lbl">Feedback</span></button>
            {nav !== 'new' && (
              <a class="h-btn h-btn--primary" href="/requests/new"><Fragment set:html={icon('plus')} /><span class="h-lbl">Make a request</span></a>
            )}
          </div>
        </header>
        <script is:inline>
          // The top bar comes after the menu script above, so the saved sections (reminders bell, clips buttons) are applied to it here, before its first paint.
          try { var s2 = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); if (s2) window.hubApplyNav(s2); if (localStorage.getItem('favor.hub.gate.v1') === '1') { var hb = document.getElementById('pp-headsearch'); var sb = document.querySelector('.h-top__search'); if (hb) hb.hidden = false; if (sb) sb.hidden = true; } } catch (e) {}
        </script>
        <main id="h-content" tabindex="-1" class={bare ? 'h-bare' : wide ? 'h-page h-page--wide' : full ? 'h-page h-page--full' : 'h-page'}>
          <slot />
        </main>
      </div>
      <NavBar curArea={curArea} />
    </div>
    <script is:inline>try { var s3 = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); if (s3) window.hubApplyNav(s3); } catch (e) {}</script>
    <CommandPalette />
    <script is:inline src="/js/hub-shell.js?v=4" defer></script>
    <script is:inline set:html={"window.__hubSwapPaths=" + JSON.stringify(SWAP_PATHS) + ";"}></script>
    <script is:inline src="/js/hub-nav.js?v=2" defer></script>
    <script is:inline src="/js/hub-swap.js?v=2" defer></script>
    <script is:inline src="/js/clips-launch.js?v=3" defer></script>
    <script is:inline src="/js/wc-bell.js?v=2" defer></script>
    <script>
      import '../scripts/hub';
    </script>
  </body>
</html>
