---
// The hub's frame: sidebar, top bar, and the page. Every hub page uses it except the sign-in page.
// hub-shell.js fills in who is signed in, the counts beside each tool, and the sections that only
// some people see (the KPI dashboard, the expense log).
import '../styles/global.css';
import '../styles/app.css';
import '../styles/feel.css';
import '../styles/elevate.css';
import '../styles/phone.css';
import '../styles/settle.css';
import '../styles/motion.css';
import '../styles/clipbtn.css';
import '../styles/partner.css';
import '../styles/ptable.css';
import '../styles/partner-crm.css';
import '../styles/comm-picture.css';
import '../styles/records.css';
import '../styles/fix-records.css';
import '../styles/wc-bell.css';
import '../styles/nudge.css';
import '../styles/color.css';
import '../styles/gifts.css';
import '../styles/brief-work.css';
import '../styles/nav.css';
import '../styles/round2.css';
import '../styles/ux-night.css';
import '../styles/ux-pass.css';
import '../styles/polish.css';
import '../styles/request-tasks.css';
import '../styles/mobile.css';
import '../styles/admin-fix.css';
import '../styles/sticky-col.css';
import '../styles/fix-shell.css';
import '../styles/crit-shell.css';
import '../styles/crit-shell2.css';
import '../styles/tour.css';
import '../styles/night-desk.css';
import '../styles/night-phone.css';
import '../styles/dock.css';
import '../styles/entity.css';
import '../styles/design-pass.css';
import '../styles/release.css';
import '../styles/integrations.css';
import '../styles/integrations-today.css';
import '../styles/nav-areas.css';
import '../styles/upgrades.css';
import '../styles/chrome.css';
import '../styles/upgrades2.css';
import CommandPalette from '../components/CommandPalette.astro';
import hubOwn from '../../public/js/hub-own.js?raw';
import liteJs from '../../public/js/lite.js?raw';
import motionJs from '../../public/js/hub-motion.js?raw';

interface Props {
  title: string;
  crumb?: string;
  nav?: string;
  wide?: boolean;
  /** Use the whole width beside the sidebar (boards and long tables), keeping the page padding. */
  full?: boolean;
  /** The page lays itself out (the Favor Brain chat): no page padding, width limit or h-page rules. */
  bare?: boolean;
  /** A meeting room: no partner tools, so joining the call waits for nothing it does not use (meetings pass 2026-10-14). */
  lean?: boolean;
  description?: string;
}

const { title, crumb = 'FavorOS', nav = '', wide = false, full = false, bare = false, lean = false, description = 'FavorOS, the Favor International staff workspace.' } = Astro.props;

import { icon } from '../data/icons';
import { badgeFor, pageBadge } from '../data/release';
import Rel from '../components/Rel.astro';
import { BUILD } from '../data/build';
import { AREAS, SWAP_PATHS, FULL_LOAD_PATHS, TAB_CAP, TOOL_LINKS, resolveNav } from '../data/areas';
import NavArea from '../components/NavArea.astro';
import NavTabs from '../components/NavTabs.astro';
import NavBar from '../components/NavBar.astro';
import LearnPanel from '../components/LearnPanel.astro';

const found = resolveNav(nav);
const curArea = found ? found.area.id : '';
// The header: the area as a breadcrumb over the page's name, and the page's own badge beside the name. An area with one page
// (Chat, Mail) or a page named for its area shows the area's name alone.
const sameAsArea = !!found && (found.page.label === found.area.label || found.page.label === found.area.short);
const headTitle = found ? (sameAsArea ? found.area.label : found.page.label) : title;
const headKey = found ? (sameAsArea ? found.area.id : `page:${found.page.id}`) : '';
const headBadge = found ? (sameAsArea ? badgeFor(found.area.id) : pageBadge(found.page.id, found.area.id)) : null;
const crumbHref = found ? (found.area.pages.find((p) => p.menu !== false) || found.area.pages[0]).href : '';
const crumbText = found ? found.area.label : crumb;
const mainAreas = AREAS.filter((a) => !a.foot).sort((x, y) => x.barRank - y.barRank);
const footAreas = AREAS.filter((a) => a.foot);
// Links to pages that swap in place need nothing fetched ahead by the browser (hub-swap.js reads them itself). Links to pages that load whole
// are fetched ahead, as HTML only: a prerendered page would run its scripts (reads, presence, polling) before anyone opened it.
const lightPaths = SWAP_PATHS.filter((p) => !FULL_LOAD_PATHS.includes(p));
const specRules = { prefetch: [{ where: { and: [{ selector_matches: '.h-side nav a[data-astro-prefetch], .h-tabs a[data-astro-prefetch]' }, { not: { or: lightPaths.map((p) => ({ href_matches: p })) } }, { not: { href_matches: '/dashboard/*' } }, { not: { href_matches: '/brain/admin/*' } }] }, eagerness: 'moderate' }] };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/images/favor-icon.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href={`/manifest.webmanifest?b=${BUILD}`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="FavorOS" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="hub-build" content={BUILD} />
    <script is:inline set:html={hubOwn}></script>
    <script is:inline set:html={liteJs}></script>
    <script is:inline set:html={motionJs}></script>
    <script is:inline src="/js/net-guard.js?v=2"></script>
    <script is:inline src="/js/app-update.js?v=3" defer></script>
    <script is:inline>
      // Lite mode draws with the phone's own fonts, so the web fonts are read ahead only when Lite is off.
      if (!(window.FavorLite && window.FavorLite.on)) ['/fonts/inter-var.woff2', '/fonts/playfair-500.woff2'].forEach(function (h) { var l = document.createElement('link'); l.rel = 'preload'; l.href = h; l.as = 'font'; l.type = 'font/woff2'; l.crossOrigin = ''; document.head.appendChild(l); });
    </script>
    <meta name="theme-color" content="#f4efe0" />
    <style is:inline>html,body{background:#f4efe0}</style>
    <script is:inline>
      // Focus rings are for the keyboard. A browser can show one after a mouse click when a script moves focus, so the page
      // marks keyboard use itself: Tab and arrow keys turn rings on, any pointer press turns them off.
      (function () {
        var r = document.documentElement;
        addEventListener('keydown', function (e) { if (e.key === 'Tab' || e.key.indexOf('Arrow') === 0) r.classList.add('kbd'); }, true);
        addEventListener('pointerdown', function () { r.classList.remove('kbd'); }, true);
      })();
    </script>
    <script is:inline>
      // The width a scrollbar takes on this computer (0 on a Mac or a tablet), for pages that fill the window (night-desk.css).
      (function () { try { var d = document.createElement('div'); d.style.cssText = 'position:absolute;top:-99px;width:50px;height:50px;overflow:scroll'; document.documentElement.appendChild(d); var w = d.offsetWidth - d.clientWidth; d.remove(); document.documentElement.style.setProperty('--sbw', w + 'px'); } catch (e) {} })();
    </script>
    <script is:inline src="/js/favor-data.js?v=1"></script>
    <script is:inline src="/js/favor-ui.js?v=1" defer></script>
    <script is:inline src="/js/favor-entity.js?v=2" defer></script>
    <script is:inline src="/js/sheets.js?v=2"></script>
    {!lean && <script is:inline>
      // The partner tools (partner card, drill-down, thank-you, call prep, records). In Lite mode a person without partner access
      // (no Work Center, gift entry or partner search) does not download them; the drill-down stays for anyone with Executive.
      (function () {
        var need = true, drill = true;
        try {
          var n = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'), a = (n && n.access) || null;
          if (window.FavorLite && window.FavorLite.on && a) {
            need = !!(a.workCenter || a.admin || a.giftEntry || localStorage.getItem('favor.hub.gate.v1') === '1');
            drill = need || !!a.kpi;
          }
        } catch (e) { need = true; drill = true; }
        window.__hubPartnerTools = need;
        var files = (drill ? ['drill.js?v=9'] : []).concat(need ? ['thank.js?v=5', 'prep.js?v=2', 'call-mode.js?v=1', 'partner-brief.js?v=3', 'comm-picture.js?v=3', 'ptable.js?v=1', 'partner-crm.js?v=1', 'partner.js?v=22', 'records.js?v=2', 'add-partner.js?v=2'] : []);
        if (files.length) document.write(files.map(function (f) { return '<script src="/js/' + f + '" defer><' + '/script>'; }).join(''));
      })();
    </script>}
    <script is:inline src="/js/ux-pass.js?v=2" defer></script>
    <script type="speculationrules" is:inline set:html={JSON.stringify(specRules)}></script>
    <script is:inline>
      // The menu opens the way this person left it (slim rail or full sidebar) before the first frame.
      try { var np = JSON.parse(localStorage.getItem('favor.hub.nav.prefs.v1') || '{}'); var nu = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null'); var pr = np[(nu && nu.user && nu.user.email) || '_'] || np._ || {}; if (pr.wide && matchMedia('(min-width: 1280px)').matches) document.documentElement.classList.add('nav-wide'); } catch (e) {}
    </script>
    <title>{title} - FavorOS</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/js/compose/compose.css?v=3" data-fc-css />
  </head>
  <body class="h-body" data-nav={nav} data-area={curArea || undefined}>
    <script is:inline>if (window.FavorLite) window.FavorLite.fontsLast();</script>
    <script is:inline src="/js/changelog-dot.js?v=1" defer></script>
    <a class="h-skip" href="#h-content">Skip to the page</a>
    <div class="h-app" id="h-app">
      <aside class="h-side" id="h-side" aria-label="FavorOS">
        <button type="button" class="h-side__x" id="h-side-x" aria-label="Close the menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        <button type="button" class="h-side__tog" id="h-wide" aria-pressed="false" aria-label="Expand the menu" data-tip="Expand the menu (press the backslash key)"><Fragment set:html={icon('chev')} /></button>
        <div class="h-side__in">
          <a class="h-brand" href="/" data-astro-prefetch="hover" aria-label="FavorOS home"><img class="h-brand__full" src="/images/favor-logo-color.png" alt="Favor International" /><img class="h-brand__mark" src="/images/favor-icon.png" alt="Favor International" /><span>OS</span></a>
          <div class="h-pins" id="h-pins" hidden><div class="h-nav__label">Pinned</div><div class="h-pins__list" id="h-pins-list"></div></div>
          <nav class="h-areas" aria-label="Areas">
            {mainAreas.map((a) => <NavArea area={a} nav={nav} curArea={curArea} />)}
          </nav>
          <div class="h-areas h-areas--foot">
            {footAreas.map((a) => <NavArea area={a} nav={nav} curArea={curArea} />)}
          </div>
          <button type="button" class="h-side__fb" data-feedback="hub" title="Tell Will what's wrong, confusing or worth adding"><Fragment set:html={icon('chat')} />Feedback</button>
        </div>
      </aside>
      <div class="h-scrim" id="h-scrim" aria-hidden="true"></div>
      <script is:inline>
        // Paint the menu the way this person last saw it, before the first frame, so entries never pop in
        // after the sign-in check. hub-shell.js refreshes the saved copy on every page.
        window.hubGate = function () {
          if (!window.__hubGateP) window.__hubGateP = fetch('/api/work/gate', { credentials: 'same-origin', headers: { 'X-Hub-Request': '1' } })
            .then(function (r) { return r.json().then(function (j) { if (!r.ok || j.ok === false) throw new Error(j.message || 'gate'); return j; }); })
            .catch(function (e) { window.__hubGateP = null; throw e; });
          return window.__hubGateP;
        };
        // Areas with nothing this person may open disappear; the rail, the tab row and the phone bar follow.
        window.hubJobMatch = function (jobs, mine) {
          if (!jobs || !jobs.length || !mine) return true;
          if (mine.indexOf('admin') >= 0) return true;
          for (var i = 0; i < jobs.length; i++) if (mine.indexOf(jobs[i]) >= 0) return true;
          return false;
        };
        window.hubNavLayout = function () {
          var q = function (sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); };
          var sums = {};
          q('.h-area').forEach(function (a) {
            var id = a.dataset.area;
            var pages = q('.h-pg:not([hidden])', a);
            a.hidden = !pages.length;
            a.classList.toggle('is-single', pages.length === 1);
            var n = 0, warn = false;
            // An area shows the sum of the numbers beside its pages, so the area and its pages always read the same.
            pages.forEach(function (pg) { var c = pg.querySelector('[data-count]:not([hidden]):not([data-count="tours"])'); if (c) { n += Number(String(c.textContent).replace(/,/g, '')) || 0; if (c.classList.contains('h-nav__count--warn')) warn = true; } });
            // Unfinished tours show beside Help's tour item only. In the area sum they turned Help into a red 12 that asked nothing of anyone.
            // Help's own number is nothing: the Feedback count beside its item belongs to Feedback, and the bell and Today carry it.
            if (id === 'help') { n = 0; warn = false; }
            sums[id] = { n: n, warn: warn };
            var target = pages[0] ? pages[0].querySelector('a') : null;
            var href = target ? target.getAttribute('href') : a.querySelector('.h-area__link').dataset.default;
            q('[data-area-link="' + id + '"]').forEach(function (l) { if (!l.closest('.h-area--pop')) l.setAttribute('href', href); });
          });
          var tabs = document.getElementById('h-tabs');
          // One tab left is still shown when it is not the open page: a person on a page outside their access sees the page they may open.
          if (tabs) { var vt = q('a.h-tab[data-nav-id]:not([hidden])', tabs); tabs.hidden = !document.documentElement.classList.contains('nav-pending') && (!vt.length || (vt.length === 1 && vt[0].classList.contains('is-on'))); }
          if (window.hubTabsLayout) window.hubTabsLayout();
          // The phone bar: Today and this person's next three areas, in rail order. More holds every other area.
          var bar = q('#h-bar [data-bar]');
          var vis = bar.filter(function (b) { var a = document.querySelector('.h-area[data-area="' + b.dataset.bar + '"]'); return a && !a.hidden; });
          vis.sort(function (x, y) { return Number(x.dataset.rank) - Number(y.dataset.rank); });
          bar.forEach(function (b) { b.hidden = vis.indexOf(b) < 0 || vis.indexOf(b) > 3; });
          q('.h-area').forEach(function (a) { a.classList.toggle('in-bar', bar.some(function (b) { return !b.hidden && b.dataset.bar === a.dataset.area; })); });
          q('[data-sum]').forEach(function (el) {
            var s = sums[el.dataset.sum];
            if (el.dataset.sum === 'more') { s = { n: 0, warn: false }; q('#h-bar [data-bar][hidden]').forEach(function (b) { var t = sums[b.dataset.bar]; if (t) s.n += t.n; }); ['admin', 'help'].forEach(function (k) { if (sums[k]) s.n += sums[k].n; }); }
            var n = s ? s.n : 0;
            el.hidden = !n;
            el.textContent = el.closest('#h-bar') && n > 99 ? '99+' : n.toLocaleString('en-US');
            el.classList.toggle('h-nav__count--warn', !!(s && s.warn));
          });
          var cur = document.querySelector('.h-area.is-cur');
          var more = document.getElementById('h-bar-more');
          if (more) more.classList.toggle('is-on', !!cur && !bar.some(function (b) { return !b.hidden && b.dataset.bar === cur.dataset.area; }));
        };
        // The tab row (src/components/NavTabs.astro): this person's job pages first, at most six in the row, the rest under More;
        // an open page under More lights the More button. The same rule as arrangeTabs in src/data/areas.ts (tests/nav-areas.test.mjs runs both).
        window.hubTabsLayout = function () {
          var nav = document.getElementById('h-tabs');
          if (!nav) return;
          var q = function (sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); };
          var row = nav.querySelector('.h-tabs__row');
          var moreBtn = row && row.querySelector('.h-tab--more');
          var moreMenu = nav.querySelector('[data-menu="more"]');
          if (!row || !moreBtn || !moreMenu) return;
          var mine = window.__hubJobs || null;
          var CAP = 6;
          // Writes only what changes: observers on the row (Reporting remembers its open tab) see no churn from a pass that changes nothing.
          var cls = function (e, c, on) { if (e.classList.contains(c) !== !!on) e.classList.toggle(c, !!on); };
          var role = function (e, v) { if (v) { if (e.getAttribute('role') !== v) e.setAttribute('role', v); } else if (e.hasAttribute('role')) e.removeAttribute('role'); };
          var put = function (e, parent, before) { if (e.parentNode !== parent || e.nextSibling !== before) parent.insertBefore(e, before); };
          var add = function (e, parent) { if (e.parentNode !== parent || e.nextSibling) parent.appendChild(e); };
          // Groups: members back in their menu; a group with one page this person may open shows that page as a plain tab.
          q('.h-tabgrp', row).forEach(function (g) {
            var menu = nav.querySelector('[data-menu="grp:' + g.dataset.grp + '"]');
            var btn = g.querySelector('.h-tab--menu');
            if (!menu || !btn) return;
            var members = q('a.h-tab[data-group]:not([hidden])', g).concat(q('a.h-tab[data-group]:not([hidden])', menu));
            var all = q('a.h-tab[data-group]', g).concat(q('a.h-tab[data-group]', menu));
            if (g.hidden !== !members.length) g.hidden = !members.length;
            if (members.length === 1) {
              if (!btn.hidden) btn.hidden = true;
              all.forEach(function (a) { if (a !== members[0]) { role(a, 'menuitem'); if (a.parentNode !== menu) menu.appendChild(a); } });
              role(members[0], ''); if (members[0].parentNode !== g) g.appendChild(members[0]);
            } else {
              all.forEach(function (a) { role(a, 'menuitem'); if (a.parentNode !== menu) menu.appendChild(a); });
              if (btn.hidden) btn.hidden = false;
              var on = members.filter(function (m) { return m.classList.contains('is-on'); })[0];
              cls(btn, 'is-on', !!on);
              // The button keeps its word ("Reports"), so its width never changes; the open page's name is in the header.
            }
          });
          var plain = q('a.h-tab[data-ord]', nav);
          var entries = plain.concat(q('.h-tabgrp', row)).sort(function (x, y) { return Number(x.dataset.ord) - Number(y.dataset.ord); });
          var shown = entries.filter(function (e) { return !e.hidden; });
          var jobsOf = function (e) { var j = e.getAttribute('data-jobs'); return j ? j.split(' ') : null; };
          var isOn = function (e) { return e.classList.contains('is-on') || !!e.querySelector('.h-tab.is-on'); };
          var anyJob = shown.some(function (e) { return jobsOf(e) && window.hubJobMatch(jobsOf(e), mine); });
          var first = anyJob ? shown.filter(function (e) { return window.hubJobMatch(jobsOf(e), mine); }) : shown.slice();
          var rest = anyJob ? shown.filter(function (e) { return !window.hubJobMatch(jobsOf(e), mine); }) : [];
          var inRow = first.slice(0, CAP);
          var inMore = first.slice(CAP).concat(rest);
          // Groups never go under More: a menu inside a menu is one tap too many.
          inMore = inMore.filter(function (e) { if (e.classList.contains('h-tabgrp')) { inRow.push(e); return false; } return true; });
          var placed = inRow.concat(entries.filter(function (e) { return e.hidden; }));
          for (var i = placed.length - 1, nx = moreBtn; i >= 0; i--) { put(placed[i], row, nx); nx = placed[i]; }
          inRow.forEach(function (e) { cls(e, 'is-job', true); if (e.tagName === 'A') role(e, ''); });
          inMore.forEach(function (e) { cls(e, 'is-job', !!(jobsOf(e) && window.hubJobMatch(jobsOf(e), mine))); role(e, 'menuitem'); add(e, moreMenu); });
          if (moreBtn.hidden !== !inMore.length) moreBtn.hidden = !inMore.length;
          // The open page under More lights the More button; the row keeps its shape from page to page.
          cls(moreBtn, 'is-on', inMore.some(isOn));
          var c = 0;
          inMore.forEach(function (e) { var n = e.querySelector('.h-nav__count:not([hidden])'); if (n) c += Number(String(n.textContent).replace(/,/g, '')) || 0; });
          var mc = moreBtn.querySelector('.h-nav__count');
          if (!mc) { mc = document.createElement('span'); mc.className = 'h-nav__count'; moreBtn.insertBefore(mc, moreBtn.lastElementChild); }
          if (mc.hidden !== !c) mc.hidden = !c;
          if (mc.textContent !== c.toLocaleString('en-US')) mc.textContent = c.toLocaleString('en-US');
        };
        window.hubApplyNav = function (d) {
          var $ = function (id) { return document.getElementById(id); };
          document.documentElement.classList.remove('nav-pending');
          var u = d.user || {};
          if (u.via === 'google' && $('h-foot')) {
            var name = u.name || u.email || '';
            $('h-name').textContent = name;
            $('h-email').textContent = u.email || '';
            var av = $('h-avatar');
            if (u.picture) {
              av.innerHTML = '';
              var img = document.createElement('img');
              img.alt = ''; img.referrerPolicy = 'no-referrer'; img.src = u.picture;
              av.appendChild(img);
            } else {
              av.textContent = String(name).split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0].toUpperCase(); }).join('');
            }
            $('h-foot').hidden = false;
          }
          // Release badges: the admin's saved changes arrive with the menu answer (src/data/release.ts).
          if (d.release) {
            window.FAVOR_REL = d.release;
            window.hubRelApply = function () {
              var rel = window.FAVOR_REL || {}, L = { alpha: 'Alpha', beta: 'Beta', new: 'New' };
              document.querySelectorAll('[data-rel]').forEach(function (el) {
                var k = el.dataset.rel, b = rel[k] || null;
                // A page link (menu or tab row) shows its badge only where it differs from its area's.
                if (b && k.indexOf('page:') === 0) { var ar = el.closest('.h-pg') ? el.closest('.h-area') : el.closest('.h-tabs'); if (ar && rel[ar.dataset.area] === b) b = null; }
                el.hidden = !b;
                el.className = 'h-rel' + (b ? ' h-rel--' + b : '') + (el.dataset.relCls ? ' ' + el.dataset.relCls : '');
                el.textContent = b ? L[b] : '';
              });
            };
            window.hubRelApply();
          }
          var access = d.access || {};
          // Whose work this person does (functions/_lib/hub/jobs.ts): the rail and the tab rows order by it. Unknown until the menu answers.
          if (Array.isArray(d.jobs)) window.__hubJobs = d.jobs;
          document.documentElement.classList.toggle('is-field', !!access.field);
          document.documentElement.classList.toggle('has-brain', !!access.brain);
          document.documentElement.classList.toggle('has-kpi', !!access.kpi);
          document.documentElement.classList.toggle('has-wc', !!access.workCenter);
          document.documentElement.classList.toggle('has-clips', !!access.clips);
          document.documentElement.classList.toggle('has-chat', !!access.chat);
          document.documentElement.classList.toggle('has-mail', !!access.mail);
          document.documentElement.classList.toggle('has-tasks', !!access.tasks);
          document.documentElement.classList.toggle('has-projects', !!access.projects); // projects hook
          document.documentElement.classList.toggle('has-clip-rec', access.clips && access.clipsRecord !== false);
          document.querySelectorAll('[data-need]').forEach(function (el) { if (access[el.dataset.need]) el.hidden = false; });
          var teams = d.kpiTeams || [];
          document.querySelectorAll('[data-kpi-team]').forEach(function (el) { el.hidden = !access.kpi || teams.indexOf(el.dataset.kpiTeam) < 0; });
          var counts = d.counts || {};
          // Tours and walkthroughs this person has not finished (src/scripts/tour.ts keeps the number), shown on Help.
          try { counts.tours = Number(localStorage.getItem('favor.hub.tours.pending')) || 0; } catch (e) {}
          window.__hubTasks = Number(counts.tasks) || 0;
          // Only the menu's own counts. Pages use data-count for other things (the Brain's stat tiles, the Projects timeline), and this
          // used to set those to 0 and hide them each time the menu refreshed.
          document.querySelectorAll('.h-nav__count[data-count]').forEach(function (el) {
            var n = Number(counts[el.dataset.count]) || 0;
            el.hidden = !n;
            el.textContent = n.toLocaleString('en-US');
            el.classList.toggle('h-nav__count--warn', el.dataset.count === 'receiptsLeft');
          });
          if (window.hubNavLayout) window.hubNavLayout();
        };
        try {
          var saved = JSON.parse(localStorage.getItem('favor.hub.nav.v1') || 'null');
          if (saved) window.hubApplyNav(saved);
          else {
            // A first visit on this browser has no saved menu: the areas wait unseen for the first answer and then show in their places
            // once, so the icons never slide down as Meetings, Chat, Mail and Admin are added. Shown anyway after 4 seconds.
            document.documentElement.classList.add('nav-pending');
            setTimeout(function () { if (!document.documentElement.classList.contains('nav-pending')) return; document.documentElement.classList.remove('nav-pending'); if (window.hubNavLayout) window.hubNavLayout(); }, 4000);
          }
          if (localStorage.getItem('favor.hub.gate.v1') === '1') document.documentElement.classList.add('has-gate');
          // Today's tour card shows while a tour or a walkthrough is waiting. A browser that has never been asked has the core tour waiting.
          var tp = localStorage.getItem('favor.hub.tours.pending');
          if (tp === null || Number(tp) > 0) document.documentElement.classList.add('show-welcome');
        } catch (e) {}
      </script>

