            <button type="button" class="h-top__cam" id="clip-cam" data-need="clipsRecord" hidden aria-haspopup="dialog" aria-expanded="false" aria-label="Record a clip" title="Record a clip"><Fragment set:html={icon('camera')} /></button>
            <LearnPanel />
          <div class="h-side__foot h-top__acct" id="h-foot" hidden>
            <button type="button" class="h-acct" id="h-acct" aria-haspopup="menu" aria-expanded="false" aria-controls="h-acctmenu" title="Your account">
              <span class="h-avatar" id="h-avatar"></span>
              <span class="h-who"><b id="h-name"></b><span id="h-email"></span></span>
            </button>
            <div class="h-acctmenu" id="h-acctmenu" role="menu" hidden>
              <a role="menuitem" href="/expenses/" data-astro-prefetch="hover"><Fragment set:html={icon('receipt')} />Expenses</a>
              <a role="menuitem" href="/learn/" data-need="learn" hidden data-astro-prefetch="hover"><Fragment set:html={icon('book')} />My learning</a>
              <a role="menuitem" href="/evaluations/" data-need="hr" hidden data-astro-prefetch="hover"><Fragment set:html={icon('badge')} />Evaluations</a>
              <a role="menuitem" href="/clips/" data-astro-prefetch="hover"><Fragment set:html={icon('clips')} />My clips</a>
              <button type="button" role="menuitem" data-clip-record><Fragment set:html={icon('camera')} />Record a clip</button>
              <a role="menuitem" href="/brain/?connect=1" data-connect-item hidden><Fragment set:html={icon('clips')} />Connect Favor Brain to Claude</a>
              {TOOL_LINKS.map((t) => <a role="menuitem" href={t.href} target="_blank" rel="noopener noreferrer"><Fragment set:html={icon('ext')} />{t.label}</a>)}
              <button type="button" role="menuitem" data-lite-open><Fragment set:html={icon('signal')} />Data saver<Rel k="lite" b={badgeFor('lite')} /></button>
              <button type="button" role="menuitem" class="h-sound" data-sound-switch data-hs-open aria-pressed="true"><Fragment set:html={icon('sound', 'h-i h-sound__on')} /><Fragment set:html={icon('mute', 'h-i h-sound__off')} />Sounds</button>
              <button type="button" role="menuitem" id="h-out"><Fragment set:html={icon('out')} />Sign out</button>
            </div>
            <script is:inline>
              // The Connect item shows only to a person who has not authorized the Favor Brain connector (brain.js has the same switch).
              (function () {
                var LIVE = true;
                var item = document.querySelector('[data-connect-item]');
                var btn = document.getElementById('h-acct');
                if (!item || !btn) return;
                btn.addEventListener('click', function () {
                  if (!(LIVE || /[?&]prompts=1\b/.test(location.search))) return;
                  fetch('/api/brain/connector', { credentials: 'same-origin' })
                    .then(function (r) { return r.json(); })
                    .then(function (d) { item.hidden = !(d && d.ok && d.connected === false); })
                    .catch(function () { item.hidden = true; });
                });
              })();
            </script>
          </div>
