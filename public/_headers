/*
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()

/api/*
  Cache-Control: no-store


/_app/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Islands keep one address per release, so the browser checks for a new copy each load.
/_app/islands/*
  Cache-Control: no-cache

# Astro's build files carry a content hash in the name, so an address never changes content.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and logos change rarely. The service worker keeps them for repeat visits; this lets a browser without it do the same.
/fonts/*
  Cache-Control: public, max-age=2592000, immutable

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/js/*
  Cache-Control: no-cache

/_tour/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/version.json
  Cache-Control: no-store

/m/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/sw.js
  Content-Type: text/javascript
  Cache-Control: no-cache
  Service-Worker-Allowed: /
